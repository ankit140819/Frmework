@page "{id?}"
@model Frmework.Areas.Admin.Pages.RetailersManageModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="mb-0">@(Model.IsEdit ? "Edit Retailer" : "Add Retailer")</h5>
                        <small class="text-muted">Manage retailer contact and role information</small>
                    </div>
                    <div>
                        <a asp-page="./Customers" class="btn btn-sm btn-outline-secondary">Back to List</a>
                    </div>
                </div>
                <div class="card-body">
                    <form method="post" novalidate>
                        <partial name="_ValidationSummary" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Retailer.FullName" class="form-label">Full name</label>
                                <input asp-for="Retailer.FullName" class="form-control form-control-lg" />
                                <span asp-validation-for="Retailer.FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Retailer.Email" class="form-label">Email</label>
                                <input asp-for="Retailer.Email" class="form-control form-control-lg" />
                                <span asp-validation-for="Retailer.Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Retailer.Phone" class="form-label">Phone</label>
                                <input asp-for="Retailer.Phone" class="form-control form-control-lg" />
                                <span asp-validation-for="Retailer.Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Retailer.Role" class="form-label">Retailer Type</label>
                                <select asp-for="Retailer.Role" class="form-select form-select-lg">
                                    <option value="Retailer">Retailer</option>
                                    <option value="Distributor">Distributor</option>
                                    <option value="Salon">Salon</option>
                                </select>
                                <span asp-validation-for="Retailer.Role" class="text-danger small"></span>
                            </div>
                        </div>

                        <input type="hidden" asp-for="Retailer.CustomerId" />

                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Save</button>
                            <a asp-page="./Customers" class="btn btn-outline-secondary btn-lg">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
