@page "{id?}"
@model Frmework.Areas.Admin.Pages.ProductsManageModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h3>@(Model.IsEdit ? "Edit Product" : "Add Product")</h3>

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Product ID</label>
            <input class="form-control" asp-for="Product.ProductId" readonly="@Model.IsEdit" />
        </div>

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input class="form-control" asp-for="Product.ProductName" />
        </div>

        <div class="mb-3">
            <label class="form-label">Price</label>
            <input class="form-control" asp-for="Product.Price" />
        </div>

        <div class="mb-3">
            <label class="form-label">Stock</label>
            <input class="form-control" asp-for="Product.Stock" />
        </div>

        <div class="mb-3">
            <label class="form-label">Short Description</label>
            <input class="form-control" asp-for="Product.ShortDescription" />
        </div>

        <button class="btn btn-primary">Save</button>
        <a asp-page="./Products" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>
