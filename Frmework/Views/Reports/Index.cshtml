@model Frmework.Models.ReportsViewModel
@{
    ViewData["Title"] = "Reports";
}

<style>
    footer{display:none;}
</style>
<div class="app-shell">
    <partial name="_DashboardSidebar" />
    <div class="main">
        <section class="content">

<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Reports</h3>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card p-3">Total Sales<br/><strong>₹@Model.TotalSalesAmount.ToString("N0")</strong></div></div>
        <div class="col-md-3"><div class="card p-3">Total Orders<br/><strong>@Model.TotalOrders</strong></div></div>
        <div class="col-md-3"><div class="card p-3">Units Sold<br/><strong>@Model.TotalUnitsSold</strong></div></div>
        <div class="col-md-3"><div class="card p-3">Customers<br/><strong>@Model.TotalCustomers</strong></div></div>
    </div>

    <div class="card mb-3 p-3">
        <form class="row g-2" method="get">
            <div class="col-md-3"><input type="date" name="from" class="form-control" /></div>
            <div class="col-md-3"><input type="date" name="to" class="form-control" /></div>
            <div class="col-md-3">
                <select name="platform" class="form-select">
                    <option>All</option>
                    @foreach(var p in (ViewBag.AllPlatforms as List<string> ?? new List<string>())){ <option>@p</option> }
                </select>
            </div>
            <div class="col-md-2">
                <select name="product" class="form-select">
                    <option>All</option>
                    @foreach(var p in (ViewBag.AllProducts as List<string> ?? new List<string>())){ <option>@p</option> }
                </select>
            </div>
            <div class="col-md-1 text-end">
                <button class="btn btn-primary">Filter</button>
            </div>
        </form>
        <div class="mt-2">
            <a class="btn btn-sm btn-outline-secondary" href="/Reports/Export">Export CSV</a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <div class="card mb-3"><div class="card-body">
                <h6>Top Products</h6>
                <ul class="list-group list-group-flush">
                    @foreach(var p in Model.TopProducts){
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @p.ProductName <span class="badge bg-primary rounded-pill">@p.UnitsSold</span>
                        </li>
                    }
                </ul>
            </div></div>
        </div>
        <div class="col-lg-6">
            <div class="card mb-3"><div class="card-body">
                <h6>Platform Summary</h6>
                <table class="table table-sm">
                    <thead><tr><th>Platform</th><th>Orders</th><th>Units</th><th>Sales</th></tr></thead>
                    <tbody>
                        @foreach(var s in Model.PlatformSummaries){
                            <tr><td>@s.Platform</td><td>@s.Orders</td><td>@s.UnitsSold</td><td>₹@s.SalesAmount.ToString("N0")</td></tr>
                        }
                    </tbody>
                </table>
            </div></div>
        </div>
    </div>

    <div class="card mt-3 p-3">
        <h6>Reports Charts</h6>
        <div class="row">
            <div class="col-md-6"><canvas id="productsChart"></canvas></div>
            <div class="col-md-6"><canvas id="platformChart"></canvas></div>
        </div>
    </div>
</div>
</section>
</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (function(){
        const topLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopProducts.Select(p=>p.ProductName)));
        const topUnits = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopProducts.Select(p=>p.UnitsSold)));

        const pltLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PlatformSummaries.Select(p=>p.Platform)));
        const pltSales = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PlatformSummaries.Select(p=>p.SalesAmount)));

        new Chart(document.getElementById('productsChart'), { type:'bar', data:{ labels: topLabels, datasets:[{ label:'Units', data: topUnits, backgroundColor:'rgba(54,162,235,0.7)'}] }, options:{responsive:true} });

        new Chart(document.getElementById('platformChart'), { type:'doughnut', data:{ labels: pltLabels, datasets:[{ data: pltSales, backgroundColor:['#007bff','#6610f2','#6f42c1','#e83e8c','#fd7e14'] }] , options:{responsive:true}});
    })();
</script>
