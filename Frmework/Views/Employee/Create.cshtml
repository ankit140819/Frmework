@model Frmework.Models.Employee

<style>
    .field-validation-error{text-align:center;display:block;}
</style>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<div class="container">
    <div class="row align-items-center justify-content-center">
        <div class="col-lg-8 mt-4">
            <div class="bg-light shadow p-4">
                <div class="text-center"><h2>Add Employee</h2></div>
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label>Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label>Department</label>
                        <input asp-for="Department" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Email</label>
                        <input asp-for="Email" class="form-control" />
                    </div>
                     <div class="mb-3">
                        <label>Salary</label>
                        <input asp-for="Salary" class="form-control" />
                     </div>
                     <div class="d-flex align-content-center justify-content-center">
                        <button type="submit" class="btn btn-success mx-4">Save</button>
                        <a asp-action="Index" class="btn btn-secondary">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
