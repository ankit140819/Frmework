@model List<Frmework.Models.Customer>
@{
    ViewData["Title"] = "Customer Inventory";
}

<style>
    footer{display:none;}
</style>
<div class="app-shell">
    <partial name="_DashboardSidebar" />
    <div class="main">
        <section class="content">

<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Customer Inventory</h3>
        <div>
            <a class="btn btn-outline-secondary ms-2" href="#"><i class="fas fa-file-export"></i> Export</a>
        </div>
    </div>

    <div class="card mb-3 p-3">
        <form class="row g-2" method="get">
            <div class="col-md-3"><input type="text" name="q" class="form-control" placeholder="Search name, email, mobile"/></div>
            <div class="col-md-3">
                <select name="city" class="form-select">
                    <option>All</option>
                    <option>Mumbai</option>
                    <option>Delhi</option>
                    <option>Chennai</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="active" class="form-select">
                    <option value="">All</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <div class="col-md-2 text-end"><button class="btn btn-primary">Filter</button></div>
        </form>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="card p-3 shadow-sm">Total Customers<br/><strong>@Model.Count</strong></div></div>
        <div class="col-md-3"><div class="card p-3 shadow-sm">Active<br/><strong>@Model.Count(c=>c.IsActive)</strong></div></div>
        <div class="col-md-3"><div class="card p-3 shadow-sm">Total Orders<br/><strong>@Model.Sum(c=>c.TotalOrders)</strong></div></div>
        <div class="col-md-3"><div class="card p-3 shadow-sm">Total Revenue<br/><strong>₹@Model.Sum(c=>c.TotalSpent).ToString("N0")</strong></div></div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Customer ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>City</th>
                        <th>Orders</th>
                        <th>Spent</th>
                        <th>Last Order</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var c in Model)
                    {
                        <tr>
                            <td>@c.CustomerId</td>
                            <td>@c.FullName</td>
                            <td>@c.Email</td>
                            <td>@c.Mobile</td>
                            <td>@c.City</td>
                            <td>@c.TotalOrders</td>
                            <td>₹@c.TotalSpent.ToString("N0")</td>
                            <td>@(c.LastOrderDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>@(c.IsActive? "Active" : "Inactive")</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="#"><i class="fas fa-eye"></i></a>
                                <a class="btn btn-sm btn-outline-secondary" href="#"><i class="fas fa-edit"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
       </div>
     </div>
</section>
</div>
</div>
