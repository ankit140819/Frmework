@model Frmework.Models.OfflineSaleViewModel
@{
    ViewData["Title"] = "Offline Seller Details";
}
<style>
    footer{display:none;}
</style>
<div class="app-shell">
    <partial name="_DashboardSidebar" />
    <div class="main">
        <section class="content">
            

<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Offline Seller Details</h3>
        <div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addOfflineSaleModal"><i class="fas fa-plus-circle"></i> Add Offline Sale</button>
            <a class="btn btn-outline-secondary ms-2" href="#"><i class="fas fa-file-export"></i> Export</a>
        </div>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Total Sales</small>
                        <div class="h5">₹@Model.TotalSalesAmount.ToString("N0")</div>
                    </div>
                    <i class="fa-solid fa-indian-rupee-sign fs-2 text-primary"></i>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Total Orders</small>
                        <div class="h5">@Model.TotalOrders</div>
                    </div>
                    <i class="fas fa-shopping-cart fs-2 text-success"></i>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Total Quantity</small>
                        <div class="h5">@Model.TotalQuantity</div>
                    </div>
                    <i class="fas fa-boxes fs-2 text-info"></i>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Paid Amount</small>
                        <div class="h5">₹@Model.PaidAmount.ToString("N0")</div>
                    </div>
                    <i class="fas fa-credit-card fs-2 text-warning"></i>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Pending Amount</small>
                        <div class="h5">₹@Model.PendingAmount.ToString("N0")</div>
                    </div>
                    <i class="fas fa-clock fs-2 text-danger"></i>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Returns/Refunds</small>
                        <div class="h5">@Model.ReturnsCount</div>
                    </div>
                    <i class="fas fa-undo fs-2 text-secondary"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Offline breakdown -->
    <div class="row mb-3">
        <div class="col-md-3"><div class="card p-3">Wholesaler Sales<br/><strong>₹@Model.WholesalerSales.ToString("N0")</strong></div></div>
        <div class="col-md-3"><div class="card p-3">Distributor Sales<br/><strong>₹@Model.DistributorSales.ToString("N0")</strong></div></div>
        <div class="col-md-3"><div class="card p-3">Retailer Sales<br/><strong>₹@Model.RetailerSales.ToString("N0")</strong></div></div>
        <div class="col-md-3"><div class="card p-3">Salon Sales<br/><strong>₹@Model.SalonSales.ToString("N0")</strong></div></div>
    </div>

    <!-- Filters -->
    <div class="card mb-3 p-3">
        <form class="row g-2" method="get">
            <div class="col-md-3">
                <input type="text" name="q" class="form-control" placeholder="Search (seller id, name)" />
            </div>
            <div class="col-md-3">
                <select name="sellerType" class="form-select">
                    <option>All</option>
                    <option>Wholesaler</option>
                    <option>Distributor</option>
                    <option>Retailer</option>
                    <option>Salon</option>
                    <option>Other Offline Sellers</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="paymentStatus" class="form-select">
                    <option>All</option>
                    <option>Paid</option>
                    <option>Pending</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="from" class="form-control" />
            </div>
            <div class="col-md-1 text-end">
                <button class="btn btn-primary">Filter</button>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover table-bordered small align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Seller ID</th>
                        <th>Seller Name</th>
                        <th>Type</th>
                        <th>Contact</th>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Qty</th>
                        <th>MRP</th>
                        <th>Price</th>
                        <th>Discount</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>Order Date</th>
                        <th>Delivery</th>
                        <th>Return</th>
                        <th>Outstanding</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var s in Model.Sales)
                    {
                        <tr>
                            <td>@s.SellerId</td>
                            <td>@s.SellerName</td>
                            <td>@s.SellerType</td>
                            <td>@s.ContactPerson<br/><small>@s.MobileNumber</small></td>
                            <td>@s.ProductName</td>
                            <td>@s.SKU</td>
                            <td>@s.Quantity</td>
                            <td>₹@s.MRP.ToString("F2")</td>
                            <td>₹@s.SellingPrice.ToString("F2")</td>
                            <td>₹@s.Discount.ToString("F2")</td>
                            <td>₹@s.TotalAmount.ToString("F2")</td>
                            <td>
                                @if(s.PaymentStatus=="Paid") { <span class="badge bg-success">Paid</span> }
                                else if(s.PaymentStatus=="Pending") { <span class="badge bg-warning">Pending</span> }
                                else { <span class="badge bg-secondary">@s.PaymentStatus</span> }
                            </td>
                            <td>@s.OrderDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if(s.DeliveryStatus=="Delivered") { <span class="badge bg-success">Delivered</span> } else { <span class="badge bg-warning">@s.DeliveryStatus</span> }
                            </td>
                            <td>
                                @if(!string.IsNullOrEmpty(s.ReturnStatus) && (s.ReturnStatus=="Returned" || s.ReturnStatus=="Refunded")) { <span class="badge bg-danger">@s.ReturnStatus</span> } else { <span class="badge bg-secondary">@s.ReturnStatus</span> }
                            </td>
                            <td>₹@s.OutstandingAmount.ToString("F2")</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="#"><i class="fas fa-eye"></i></a>
                                <a class="btn btn-sm btn-outline-secondary" href="#"><i class="fas fa-edit"></i></a>
                                <a class="btn btn-sm btn-outline-danger" href="#"><i class="fas fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer d-flex justify-content-between align-items-center">
            <div>
                <small class="text-muted">Showing @Model.Sales.Count items</small>
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item disabled"><a class="page-link">«</a></li>
                    <li class="page-item active"><a class="page-link">1</a></li>
                    <li class="page-item"><a class="page-link">2</a></li>
                    <li class="page-item"><a class="page-link">3</a></li>
                    <li class="page-item"><a class="page-link">»</a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>

</section>
        </div>
        </div>

<!-- Add Offline Sale Modal -->
<div class="modal fade" id="addOfflineSaleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="font-size:12px;">
            <div class="modal-header">
                <h5 class="modal-title">Add Offline Sale</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label">Seller Type</label>
                            <select class="form-select">
                                <option>Wholesaler</option>
                                <option>SPY</option>
                                <option>Salon</option>
                                <option>Distributor</option>
                                <option>Retailer</option>
                                <option>Other Offline Sellers</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Seller ID</label>
                            <input class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Business/Seller Name</label>
                            <input class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Contact Person</label>
                            <input class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Mobile</label>
                            <input class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Email</label>
                            <input class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Product Name</label>
                            <input class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">SKU</label>
                            <input class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Quantity</label>
                            <input type="number" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Wholesale Price</label>
                            <input type="number" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Selling Price</label>
                            <input type="number" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Discount</label>
                            <input type="number" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Remarks</label>
                            <textarea class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>
