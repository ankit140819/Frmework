<!-- ====================================================== -->
<!-- ADD PRODUCT MODAL -->
<!-- ====================================================== -->

<div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <!-- MODAL HEADER -->
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold" id="addProductModalLabel">

                        Add New Product

                    </h5>

                    <small class="text-muted">

                        Enter product inventory details

                    </small>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- MODAL BODY -->

            <div class="modal-body">

                <div class="row g-3">
                    <!-- PRODUCT CODE -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                            Product Code
                            <span class="text-danger">*</span>

                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Product Code">

                    </div>


                    <!-- PRODUCT CODE -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                              SKU Number
                            <span class="text-danger">*</span>

                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="e.g. 23U-CBC-001">

                    </div>


                    <!-- PRODUCT NAME -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                            Product Name
                            <span class="text-danger">*</span>

                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Enter product name">

                    </div>


                    <!-- BATCH NUMBER -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                            Batch Number
                            <span class="text-danger">*</span>

                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Enter batch number">

                    </div>


                    <!-- MRP -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                            MRP
                            <span class="text-danger">*</span>

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₹
                            </span>

                            <input type="number"
                                   class="form-control"
                                   placeholder="Enter MRP">

                        </div>

                    </div>


                    <!-- MANUFACTURING DATE -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                            Manufacturing Date
                            <span class="text-danger">*</span>

                        </label>

                        <input type="date"
                               class="form-control">

                    </div>


                    <!-- EXPIRY DATE -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                            Expiry Date
                            <span class="text-danger">*</span>

                        </label>

                        <input type="date"
                               class="form-control">

                    </div>


                    <!-- QUANTITY -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                            Quantity
                            <span class="text-danger">*</span>

                        </label>

                        <input type="number"
                               class="form-control"
                               placeholder="Enter quantity">

                    </div>


                    <!-- TOTAL AMOUNT -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                            Total Product Amount
                            <span class="text-danger">*</span>

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₹
                            </span>

                            <input type="number"
                                   class="form-control"
                                   placeholder="Enter total amount">

                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                            Status
                            <span class="text-danger">*</span>

                        </label>

                        <select class="form-select">

                            <option selected disabled>
                                Select Status
                            </option>

                            <option value="Healthy">
                                Healthy
                            </option>

                            <option value="Warning">
                                Warning
                            </option>

                            <option value="Critical">
                                Critical
                            </option>

                        </select>

                    </div>


                    <!-- REMARKS -->

                    <div class="col-md-8">

                        <label class="form-label fw-semibold">

                            Remarks

                        </label>

                        <textarea class="form-control"
                                  rows="3"
                                  placeholder="Enter remarks"></textarea>

                    </div>

                </div>

            </div>


            <!-- MODAL FOOTER -->

            <div class="modal-footer">

                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-dark px-4">Save Product</button>

            </div>

        </div>

    </div>

</div>
        </section>
    </div>
</div>
