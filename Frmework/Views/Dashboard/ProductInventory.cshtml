@model InventoryDashboardMvc.Models.DashboardInventoryModel
@{
    ViewData["Title"] = "Product Inventory";
}
<style>
    footer{display:none;}
</style>
<style>

#addProductModal {
    font-size: 12px;
}

#addProductModal .modal-title {
    font-size: 16px;
}

#addProductModal .form-label {
    font-size: 12px;
}

#addProductModal .form-control,
#addProductModal .form-select,
#addProductModal .input-group-text {
    font-size: 12px;
}

#addProductModal .form-control::placeholder {
    font-size: 12px;
}

#addProductModal .modal-footer .btn {
    font-size: 12px;
}

#addProductModal small {
    font-size: 11px;
}
</style>

<div class="app-shell">
    <partial name="_DashboardSidebar" />
    <div class="main">
       <section class="content">
 

<div class="container-fluid py-4 bg-light min-vh-100">

