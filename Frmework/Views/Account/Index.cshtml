@{
    ViewData["Title"] = "Sign Up";
}

<style>
    .signup-wrapper { min-height: 80vh; display: flex; align-items: center; }
    .signup-card { border-radius: 1rem; overflow: hidden; }
    .signup-hero { background: linear-gradient(135deg,#4f46e5 0%,#06b6d4 100%); color: white; padding: 2.5rem; }
    .signup-hero h2 { font-weight: 700; }
    .signup-hero p { opacity: .95; }
    .illustration { font-size: 3.2rem; opacity: .95; }

    .has-toggle { position: relative; }
    .has-toggle .form-control { padding-right: 4.6rem; }
    .has-toggle .form-floating > label { z-index: 1; }
    .has-toggle .form-control { z-index: 2; }
    .has-toggle .toggle-btn {
        position: absolute; top: 50%; right: .6rem; transform: translateY(-50%);
        z-index: 3; border: none; background: transparent; padding: .2rem .35rem; width: 2.4rem; height: 2.4rem;
        display: inline-flex; align-items: center; justify-content: center; border-radius: .375rem; cursor: pointer;
    }
    .has-toggle .toggle-btn .fa { color: #6c757d; font-size: 1rem; }

    .social-btn-google { border-color: #db4437; color: #db4437; }
    .social-btn-facebook { border-color: #1877f2; color: #1877f2; }
</style>
<main class="signup-wrapper">
    <div class="container">
        <div class="row justify-content-center my-4">
            <div class="col-12 col-md-10 col-lg-9">
                <div class="card signup-card shadow-lg">
                    <div class="row g-0">
                        <aside class="col-md-5 signup-hero d-flex flex-column justify-content-center align-items-start">
                            <div class="px-4">
                                <div class="illustration mb-3"><i class="fa fa-user-plus"></i></div>
                                <h2>Create your account</h2>
                                <p class="mt-2">Join to access deals, track orders and manage preferences.</p>
                                <ul class="list-unstyled mt-3">
                                    <li><i class="fa fa-check-circle me-2"></i>Fast checkout</li>
                                    <li><i class="fa fa-check-circle me-2"></i>Order tracking</li>
                                    <li><i class="fa fa-check-circle me-2"></i>Secure payments</li>
                                </ul>
                            </div>
                        </aside>
                        <section class="col-md-7">
                            <div class="card-body p-4 p-md-5">
                                @if (ViewBag.Error != null)
                                {
                                    <div class="alert alert-danger">@ViewBag.Error</div>
                                }

                                <form asp-action="Index" method="post" novalidate id="registerForm">
                                    @Html.AntiForgeryToken()

                                    <div class="row">
                                        <div class="col-12 mb-3">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" id="floatingName" name="name" placeholder="Full name" required />
                                                <label for="floatingName">Full name</label>
                                                <div class="invalid-feedback">Please enter your name.</div>
                                            </div>
                                        </div>

                                        <div class="col-12 mb-3">
                                            <div class="form-floating">
                                                <input type="email" class="form-control" id="floatingEmail" name="email" placeholder="name@example.com" required />
                                                <label for="floatingEmail">Email address</label>
                                                <div class="invalid-feedback">Please enter a valid email.</div>
                                            </div>
                                        </div>

                                        <div class="col-12 mb-3">
                                            <div class="form-floating has-toggle">
                                                <input type="password" class="form-control" id="floatingPassword" name="password" placeholder="Password" required />
                                                <label for="floatingPassword">Password</label>
                                                <div class="invalid-feedback">Please enter a password.</div>
                                                <button type="button" class="toggle-btn" aria-label="Toggle password visibility" onclick="togglePassword('floatingPassword','passwordEyeIcon')">
                                                    <i id="passwordEyeIcon" class="fa fa-eye" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                            <div class="mt-2">
                                                <small id="passwordHelp" class="text-muted">Use at least 8 characters. Include numbers and symbols for a stronger password.</small>
                                                <div class="progress mt-2" style="height:6px;">
                                                    <div id="pwStrength" class="progress-bar" role="progressbar" style="width:0%"></div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 mb-3">
                                            <div class="form-floating has-toggle">
                                                <input type="password" class="form-control" id="floatingConfirmPassword" name="confirmPassword" placeholder="Confirm Password" required />
                                                <label for="floatingConfirmPassword">Confirm Password</label>
                                                <div class="invalid-feedback" id="confirmFeedback">Please confirm your password.</div>
                                                <button type="button" class="toggle-btn" aria-label="Toggle confirm password visibility" onclick="togglePassword('floatingConfirmPassword','confirmEyeIcon')">
                                                    <i id="confirmEyeIcon" class="fa fa-eye" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="col-12 mb-3">
                                            <div class="d-grid">
                                                <button type="submit" class="btn btn-primary btn-lg">Create account</button>
                                            </div>
                                        </div>

                                        <div class="col-12 text-center">
                                            <small class="text-muted">or continue with</small>
                                            <div class="d-flex gap-2 justify-content-center mt-2">
                                                <button type="button" class="btn btn-outline-secondary social-btn-google"><i class="fa-brands fa-google me-2"></i>Google</button>
                                                <button type="button" class="btn btn-outline-secondary social-btn-facebook"><i class="fa-brands fa-facebook me-2"></i>Facebook</button>
                                            </div>
                                            <p class="mt-3 mb-0"><small class="text-muted">Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a></small></p>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    function togglePassword(inputId, iconId) {
        var input = document.getElementById(inputId);
        var icon = document.getElementById(iconId);
        if (!input || !icon) return;

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    // Password strength meter (simple)
    (function () {
        var pw = document.getElementById('floatingPassword');
        var confirm = document.getElementById('floatingConfirmPassword');
        var form = document.getElementById('registerForm');
        var strength = document.getElementById('pwStrength');

        function scorePassword(s) {
            var score = 0;
            if (!s) return 0;
            if (s.length >= 8) score += 25;
            if (/[A-Z]/.test(s)) score += 20;
            if (/[0-9]/.test(s)) score += 25;
            if (/[^A-Za-z0-9]/.test(s)) score += 30;
            return Math.min(score, 100);
        }

        function updateStrength() {
            var val = pw.value;
            var sc = scorePassword(val);
            strength.style.width = sc + '%';
            strength.className = 'progress-bar ' + (sc < 40 ? 'bg-danger' : sc < 70 ? 'bg-warning' : 'bg-success');
        }

        if (pw) pw.addEventListener('input', updateStrength);

        if (form) {
            form.addEventListener('submit', function (e) {
                // Bootstrap validation
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                    form.classList.add('was-validated');
                    return;
                }

                // check password match
                if (pw && confirm && pw.value !== confirm.value) {
                    e.preventDefault();
                    e.stopPropagation();
                    confirm.classList.add('is-invalid');
                    document.getElementById('confirmFeedback').textContent = 'Passwords do not match.';
                    return;
                }
            }, false);
        }
    })();
</script>
