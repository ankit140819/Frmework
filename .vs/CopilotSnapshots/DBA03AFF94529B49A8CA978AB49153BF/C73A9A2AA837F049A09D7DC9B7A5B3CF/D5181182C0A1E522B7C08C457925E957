.products-page {
    --products-ink: #302b2b;
    --products-muted: #806f6c;
    --products-rose: #c98d84;
    --products-blush: #f8ece9;
    --products-line: #eee0dc;
    background: #fcf9f7;
    color: var(--products-ink);
    padding-bottom: 48px;
}

.products-page .products-hero {
    background: linear-gradient(110deg, #f8e9e5, #fffaf8) !important;
    color: var(--products-ink);
    border-bottom: 1px solid var(--products-line);
}

.products-page .products-hero h1 {
    color: var(--products-ink) !important;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 400;
    letter-spacing: -.03em;
}

.products-page .products-hero p { color: var(--products-muted) !important; max-width: 650px; }
.products-hero-image { width: 220px; height: 190px; object-fit: contain; }

.products-page .bg-light,
.products-page aside .card {
    background: #fff !important;
    border: 1px solid var(--products-line) !important;
    box-shadow: 0 8px 24px rgba(80, 52, 48, .05) !important;
}

.products-page aside .card { top: 90px !important; }
.products-page aside h5 { font-family: Georgia, "Times New Roman", serif; font-weight: 400 !important; }
.products-page .filter-group { animation: none; }
.products-page .filter-options .form-check-label { color: var(--products-muted); }
.products-page .filter-options .form-check-input:checked ~ .form-check-label { color: var(--products-rose); }
.products-page .form-control:focus,
.products-page .form-select:focus { border-color: #d7aaa2; box-shadow: 0 0 0 .2rem rgba(201, 141, 132, .15); }

.products-page .btn-primary,
.products-page .btn-primary:hover {
    background: var(--products-ink) !important;
    border-color: var(--products-ink) !important;
    box-shadow: none !important;
    transform: none !important;
}

.products-page .product-card {
    background: #fff;
    border: 1px solid var(--products-line) !important;
    border-radius: 12px !important;
    box-shadow: 0 5px 18px rgba(80, 52, 48, .05) !important;
    transition: transform .25s ease, box-shadow .25s ease;
}

.products-page .product-card:hover {
    border-color: #dfbbb5 !important;
    box-shadow: 0 14px 30px rgba(80, 52, 48, .11) !important;
    transform: translateY(-5px);
}

.products-page .product-card > .position-relative:first-child {
    height: 250px !important;
    background: var(--products-blush) !important;
}

.products-page .product-img {
    object-fit: contain !important;
    padding: 18px;
    transition: transform .3s ease;
}

.products-page .product-card:hover .product-img { transform: scale(1.04); }
.products-page .product-card h5 { font-family: Georgia, "Times New Roman", serif; font-weight: 400 !important; }
.products-page .product-card .text-primary,
.products-page .product-card .fw-bold.fs-5 { color: var(--products-ink) !important; }
.products-page .product-card .bg-gradient-primary { background: var(--products-blush) !important; color: #8d665f !important; }
.products-page .product-actions { background: linear-gradient(180deg, transparent, rgba(48, 43, 43, .6)) !important; }
.products-page .product-badge {
    background: rgba(255, 255, 255, .9) !important;
    color: #9b625a !important;
    border: 1px solid #efd5d0;
    font-size: .68rem;
    letter-spacing: .08em;
    box-shadow: 0 4px 12px rgba(80, 52, 48, .08);
}
.products-page .product-badge i { color: #c98d84; margin-right: 4px; }
.products-page .wish-btn {
    border: 1px solid #eadbd7 !important;
    color: #9c7771;
    background: rgba(255,255,255,.92) !important;
    transition: color .2s ease, background .2s ease, transform .2s ease, box-shadow .2s ease;
}
.products-page .wish-btn i { font-size: 1rem; transition: transform .2s ease; }
.products-page .wish-btn:hover { background: #fff !important; color: #bd7268 !important; transform: scale(1.08); box-shadow: 0 8px 18px rgba(80, 52, 48, .12) !important; }
.products-page .wish-btn:hover i { transform: scale(1.16); }
.products-page .wish-btn.active { color: #bd7268 !important; background: #fbeceb !important; border-color: #e7bbb5 !important; }
.products-page .wish-btn.active i { font-family: "Font Awesome 6 Free"; font-weight: 900; }
.products-page .product-actions .btn { border-radius: 7px !important; font-size: .76rem; letter-spacing: .02em; }
.products-page .product-actions .btn i { margin-right: 5px; }
.products-page .product-card .fa-star,
.products-page .product-card .fa-star-half-alt { color: #d3a33c !important; filter: drop-shadow(0 1px 1px rgba(180, 125, 30, .15)); }
.products-page .product-card .fa-droplet { color: #c98d84; margin-right: 4px; }
.products-page .product-card .fa-bag-shopping { color: #f2d9d4; }
.products-page .product-card .btn-primary:hover .fa-bag-shopping { color: #fff; }
.products-page .pagination .page-link { color: var(--products-ink); border-color: var(--products-line); }
.products-page .pagination .page-item.active .page-link,
.products-page .pagination .page-link:hover { background: var(--products-ink); border-color: var(--products-ink); color: #fff; }

@media (max-width: 768px) {
    .products-page .products-hero { padding: 38px 0 !important; text-align: center; }
    .products-hero-image { width: 150px; height: 130px; margin-top: 20px; }
    .products-page aside .card { position: static !important; }
    .products-page .product-card > .position-relative:first-child { height: 220px !important; }
    .products-page .product-actions { opacity: 1 !important; transform: none !important; }
}