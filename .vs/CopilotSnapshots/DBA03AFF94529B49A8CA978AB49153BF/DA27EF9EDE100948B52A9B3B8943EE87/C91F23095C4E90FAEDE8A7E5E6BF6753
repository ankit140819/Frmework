<script>
    gsap.registerPlugin(ScrollTrigger);
    const box = document.getElementById("revealBox");
    const caption = document.getElementById("caption");
    const left = document.getElementById("word-left");
    const right = document.getElementById("word-right");
    const tl = gsap.timeline({
        scrollTrigger: {
            trigger: ".pin-wrap",
            start: "top top",
            end: "bottom bottom",
            scrub: 0.6,
        },
    });
    tl.to(box, {
        width: "75vw",
        height: "75vh",
        borderRadius: 0,
        ease: "none",
    }, 0, ).to(left, {
        x: "-60vw",
        opacity: 0,
        ease: "none",
    }, 0, ).to(right, {
        x: "60vw",
        opacity: 0,
        ease: "none",
    }, 0, ).to(caption, {
        opacity: 1,
        ease: "none",
