        }
        /* =====================================
                               GIRL IMAGE MOBILE
                            ===================================== */

        .girl-section {
            width: 100%;
            height: 100svh;
            min-height: 600px;
            overflow: hidden;
            position: relative;
            background: #000;
        }


        .girl-image {
            width: 100%;
            height: 100%;
            position: absolute;
            inset: 0;
            display: block;
            object-fit: cover;
            /*
                                   Change this value if you want
                                   to move the girl's face.
                                */

            object-position: center center;
        }
        /* CONTENT */

        .content-section {
            min-height: 100svh;
            padding: 60px 20px;
        }


        .content-container h2 {
            font-size: 35px;
        }


        .content-container p {
            font-size: 16px;
        }
    }


    /* =========================================
                           SMALL MOBILE
                        ========================================= */

    @media (max-width: 480px) {

        .logo {
            width: 90px;
        }


        .mobile-menu-btn {
            width: 40px;
            height: 40px;
            font-size: 19px;
        }


        .intro-section {
            min-height: 500px;
        }


        .intro-title {
            font-size: 26px;
            gap: 9px;
        }


        .blur-shape {
            width: 75px;
            height: 27px;
        }


        .girl-section {
            min-height: 550px;
            height: 100svh;
        }
    }


    /* =========================================
                           MOBILE MENU
                        ========================================= */

    .mobile-menu {
        display: none;
        position: fixed;
        top: 70px;
        right: 15px;
        width: 220px;
        background: #777167;
        border-radius: 18px;
        padding: 20px;
        z-index: 2000;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }


        .mobile-menu.active {
            display: block;
        }


        .mobile-menu a {
            display: block;
            color: #fff;
            text-decoration: none;
            padding: 12px 5px;
            font-size: 15px;
            font-weight: 600;
            border-bottom: 1px solid rgba(255,255,255,0.15);
        }


            .mobile-menu a:last-child {
                border-bottom: none;
            }

</style>

<!-- ============ HERO SECTION ============ -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 hero-content">
                <h1>Your Beauty, Our Science</h1>
                <p>Discover premium skincare products crafted with precision ingredients that deliver visible, lasting results. Rooted in modern science and timeless tradition.</p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="@Url.Action("Products", "Home")" class="cta-button text-white">Shop Now</a>
                    <a href="#about" class="cta-button cta-button-secondary">Learn More</a>
                </div>
            </div>
            <div class="col-lg-6">
                <img src="/images/C00001.png" alt="Premium Skincare" class="img-fluid hero-image" style="max-width: 100%; border-radius: 20px;">
            </div>
        </div>
    </div>
</section>

<!-- ============ STATS SECTION ============ -->
<section class="stats-section">
    <div class="container">
        <div class="row">
            <div class="col-md-3 stat-card">
                <div class="stat-number">50K+</div>
                <div class="stat-label">Happy Customers</div>
            </div>
            <div class="col-md-3 stat-card">
                <div class="stat-number">100+</div>
                <div class="stat-label">Premium Products</div>
            </div>
            <div class="col-md-3 stat-card">
                <div class="stat-number">15+</div>
                <div class="stat-label">Years Experience</div>
            </div>
            <div class="col-md-3 stat-card">
                <div class="stat-number">99%</div>
                <div class="stat-label">Satisfaction Rate</div>
            </div>
        </div>
    </div>
</section>

<!-- ============ FEATURES SECTION ============ -->
