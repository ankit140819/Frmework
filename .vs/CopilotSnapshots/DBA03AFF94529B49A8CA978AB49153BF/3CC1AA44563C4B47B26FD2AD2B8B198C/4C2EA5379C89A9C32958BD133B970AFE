    .mobile-menu-btn {
        display: none;
        width: 45px;
        height: 45px;
        border: none;
        border-radius: 50%;
        background: #000;
        color: #fff;
        font-size: 22px;
        cursor: pointer;
    }


    /* =========================================
                           TABLET
                        ========================================= */

    @media (max-width: 1100px) {

        .navbar {
            padding: 0 25px;
        }

        .nav-links {
            gap: 18px;
        }

            .nav-links a {
                font-size: 14px;
            }

        .contact-btn {
            margin-left: 20px;
            padding: 14px 25px;
        }

        .intro-title {
            font-size: 42px;
