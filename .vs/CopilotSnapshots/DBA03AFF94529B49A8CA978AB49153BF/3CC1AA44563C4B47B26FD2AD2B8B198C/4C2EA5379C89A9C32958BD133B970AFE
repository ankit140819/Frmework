        }


    /* BLURRED ELEMENT */

    .blur-shape {
        width: 180px;
        height: 46px;
        border-radius: 30px;
        background: #aaa;
        filter: blur(1px);
        opacity: 0.9;
    }


    /* =========================================
                           GIRL IMAGE SECTION
                        ========================================= */

    .girl-section {
        width: 100%;
        height: 100vh;
        min-height: 650px;
        position: relative;
        overflow: hidden;
