                    <p>All products tested and approved by leading dermatologists for safety and efficacy.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-truck-fast"></i></div>
                    <h3>Fast Shipping</h3>
                    <p>Free shipping on orders over ₹500. Delivery within 2-3 business days.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-shield-alt"></i></div>
                    <h3>Secure Payment</h3>
                    <p>100% secure payment gateway with SSL encryption for your peace of mind.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ FEATURED PRODUCTS ============ -->
<section class="products-section">
    <div class="container">
        <div class="section-title">
            <div class="title-underline"></div>
            <h2>Featured Products</h2>
            <p>Handpicked essentials for your skincare routine</p>
        </div>
        <div class="row g-4">
            @if (Model != null && Model.Count > 0)
            {
                @for (int i = 0; i < Math.Min(3, Model.Count); i++)
                {
                    var product = Model[i];
                    <div class="col-lg-4 col-md-6">
                        <div class="product-showcase-card">
                            <img src="~/images/@(product.Product_Id).png" alt="@product.Product_Name" style="height: 200px; object-fit: contain;">
                            <h3>@product.Product_Name</h3>
                            <p>@product.Short_Description</p>
                            <div class="product-price">₹ @product.Product_Amount</div>
                            <a href="@Url.Action("Product_Details", "Home", new { id = product.Product_Id })" class="cta-button" style="background: white; color: var(--primary-color);">View Details</a>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="text-center mt-5">
            <a href="@Url.Action("Products", "Home")" class="cta-button">View All Products</a>
        </div>
    </div>
</section>

<!-- ============ WHY CHOOSE US ============ -->
<section class="why-choose-section" id="about">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="section-title" style="text-align: left;">
                    <div class="title-underline" style="margin-left: 0;"></div>
                    <h2>Our Mission & Vision</h2>
                </div>
                <p style="font-size: 1.1rem; color: #666; line-height: 1.8; margin-bottom: 30px;">
                    We believe that beautiful skin is healthy skin. Our mission is to provide high-performance skincare products that combine cutting-edge science with nature's finest ingredients. Every product is meticulously crafted to deliver visible results while respecting your skin's natural balance.
                </p>
                <ul class="why-choose-list">
                    <li><i class="fas fa-check-circle"></i> Science-backed formulations</li>
