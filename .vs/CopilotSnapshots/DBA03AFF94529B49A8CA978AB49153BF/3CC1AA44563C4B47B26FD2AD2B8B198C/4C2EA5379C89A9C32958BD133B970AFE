    .girl-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center center;
    }


    /* =========================================
                           THIRD SECTION - EXAMPLE
                        ========================================= */

    .content-section {
        width: 100%;
        min-height: 100vh;
        background: #f3dfc3;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 80px 30px;
    }


    .content-container {
        max-width: 1100px;
        width: 100%;
        text-align: center;
    }


        .content-container h2 {
            font-size: 50px;
            margin-bottom: 20px;
        }


        .content-container p {
            max-width: 700px;
            margin: auto;
            font-size: 18px;
            line-height: 1.7;
