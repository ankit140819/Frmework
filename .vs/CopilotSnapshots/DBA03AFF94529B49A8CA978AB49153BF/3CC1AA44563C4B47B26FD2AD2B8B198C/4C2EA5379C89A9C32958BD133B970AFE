        }
        /* INTRO */

        .intro-section {
            height: 100svh;
            min-height: 550px;
            padding: 20px;
        }


        .intro-title {
            width: 100%;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            text-align: center;
            gap: 12px;
