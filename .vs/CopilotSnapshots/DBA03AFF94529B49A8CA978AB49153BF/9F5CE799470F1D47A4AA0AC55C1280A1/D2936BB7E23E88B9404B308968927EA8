@{
    ViewData["Title"] = "About Us";
}

<!-- Improved About Page: Hero + Highlights -->
<section class="about-hero py-5 text-white" style="background: linear-gradient(135deg, rgba(102,126,234,1) 0%, rgba(118,75,162,1) 50%, rgba(255,107,157,1) 100%); box-shadow: inset 0 0 120px rgba(0,0,0,0.08);">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold text-white">About GlowSkin</h1>
                <p class="lead text-white-50">We craft premium, science-backed skincare to help you feel confident in your skin. Clean ingredients, ethical practices, proven results.</p>

                <div class="mt-4 d-flex gap-3 flex-wrap">
                    <div class="card border-0 shadow-sm p-3" style="min-width:160px;">
                        <div class="h1 text-primary">🌿</div>
                        <h6 class="fw-bold">Natural & Effective</h6>
                        <small class="text-muted">Botanicals + actives with clinical support.</small>
                    </div>
                    <div class="card border-0 shadow-sm p-3" style="min-width:160px;">
                        <div class="h1 text-primary">🔬</div>
                        <h6 class="fw-bold">Derm-Backed</h6>
                        <small class="text-muted">Formulated with experts and trials.</small>
                    </div>
                    <div class="card border-0 shadow-sm p-3" style="min-width:160px;">
                        <div class="h1 text-primary">♻️</div>
                        <h6 class="fw-bold">Sustainable</h6>
                        <small class="text-muted">Eco-conscious packaging & cruelty-free.</small>
                    </div>
                </div>

                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Products" class="btn btn-primary btn-lg me-2 hero-cta"><i class="fas fa-shopping-bag me-2"></i>Shop Now</a>
                    <a href="#why-us" class="btn btn-outline-secondary btn-lg outline-cta text-white"><i class="fas fa-star me-2"></i>Why Choose Us</a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <img src="~/images/C00005.png" alt="About GlowSkin" class="img-fluid rounded-4 shadow" style="max-height:420px; object-fit:cover;" />
            </div>
        </div>
    </div>
</section>

<style>
    .hero-cta {
        background: linear-gradient(90deg, #ff6b9d 0%, #00d4ff 100%);
        border: none;
        padding: 12px 26px;
        border-radius: 50px;
        font-weight: 700;
        box-shadow: 0 8px 30px rgba(102,126,234,0.12), 0 4px 12px rgba(0,0,0,0.06);
        transition: transform .25s ease, box-shadow .25s ease;
    }
    .hero-cta:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 18px 50px rgba(102,126,234,0.18);
    }

    .outline-cta {
        border: 2px solid rgba(102,126,234,0.12);
        background: transparent;
        color: #333;
        padding: 12px 22px;
        border-radius: 50px;
        font-weight: 700;
        transition: all .25s ease;
    }
    .outline-cta:hover {
        background: linear-gradient(90deg, rgba(102,126,234,0.06), rgba(118,75,162,0.06));
        color: #111;
        transform: translateY(-3px);
    }

    .contact-cta {
        background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        border: none;
        padding: 10px 22px;
        border-radius: 28px;
        font-weight: 700;
        color: white;
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .contact-cta:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(118,75,162,0.18); }

    .subscribe-btn {
        background: linear-gradient(90deg, #00d4ff 0%, #667eea 100%);
        border: none;
        padding: 10px 20px;
        border-radius: 28px;
        font-weight: 700;
        color: #fff;
        transition: transform .2s ease;
    }
    .subscribe-btn:hover { transform: translateY(-3px); }

    /* small icon spacing for buttons */
    .btn i { margin-right: 8px; }
</style>

<!-- Why Choose Us / Mission and Values -->
<section id="why-us" class="py-5">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-7">
                <h3 class="fw-bold">Our Mission</h3>
                <p class="text-muted">Deliver accessible, effective skincare rooted in research and transparency. We prioritize clean formulations and measurable results.</p>

                <ul class="list-unstyled">
                    <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Clinically tested actives</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Cruelty-free and sustainable</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Transparent ingredient lists</li>
                </ul>
            </div>
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm p-4">
                    <h5 class="fw-bold">Our Values</h5>
                    <p class="text-muted">Quality, sustainability, and proven results. We partner with ethical suppliers and maintain high quality control.</p>

                    <div class="d-flex gap-3 mt-3 justify-content-between">
                        <div class="text-center">
                            <h4 class="mb-0">98%</h4>
                            <small class="text-muted">Customer Satisfaction</small>
                        </div>
                        <div class="text-center">
                            <h4 class="mb-0">500+</h4>
                            <small class="text-muted">Products shipped daily</small>
                        </div>
                        <div class="text-center">
                            <h4 class="mb-0">150+</h4>
                            <small class="text-muted">Clinical validations</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Timeline / Milestones -->
<section class="py-5 bg-light">
    <div class="container">
        <h3 class="fw-bold text-center mb-4">Our Journey</h3>
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="timeline">
                    <div class="d-flex mb-4">
                        <div style="Width:60px; text-align:center;">
                            <div class="rounded-circle bg-primary text-white" style="width:48px;height:48px;line-height:48px;">2018</div>
                        </div>
                        <div class="ms-3">
                            <h6 class="mb-1 fw-bold">Founded</h6>
                            <p class="text-muted mb-0">GlowSkin was founded with a vision to make evidence-based skincare available to everyone.</p>
                        </div>
                    </div>
                    <div class="d-flex mb-4">
                        <div style="Width:60px; text-align:center;">
                            <div class="rounded-circle bg-primary text-white" style="width:48px;height:48px;line-height:48px;">2020</div>
                        </div>
                        <div class="ms-3">
                            <h6 class="mb-1 fw-bold">First Clinical Trial</h6>
                            <p class="text-muted mb-0">Published our first third-party clinical evaluation demonstrating efficacy for hydration.</p>
                        </div>
                    </div>
                    <div class="d-flex mb-4">
                        <div style="Width:60px; text-align:center;">
                            <div class="rounded-circle bg-primary text-white" style="width:48px;height:48px;line-height:48px;">2023</div>
                        </div>
                        <div class="ms-3">
                            <h6 class="mb-1 fw-bold">Sustainability Pledge</h6>
                            <p class="text-muted mb-0">Launched eco-friendly packaging across our core SKU line.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials Carousel -->
<section class="py-5">
    <div class="container">
        <h3 class="fw-bold text-center mb-4">What Customers Say</h3>
        <div id="testimonialsCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner text-center">
                <div class="carousel-item active">
                    <blockquote class="blockquote">
                        <p class="mb-3">"My skin has never felt better — noticeable results in 2 weeks."</p>
                        <footer class="blockquote-footer text-white">A. Reddy, <cite title="Source Title">Verified Buyer</cite></footer>
                    </blockquote>
                </div>
                <div class="carousel-item">
                    <blockquote class="blockquote">
                        <p class="mb-3">"Clean formulas that actually deliver — love the texture and smell."</p>
                        <footer class="blockquote-footer text-white">K. Sinha, <cite title="Source Title">Verified Buyer</cite></footer>
                    </blockquote>
                </div>
                <div class="carousel-item">
                    <blockquote class="blockquote">
                        <p class="mb-3">"Fantastic customer support and fast shipping."</p>
                        <footer class="blockquote-footer text-white">M. Thomas, <cite title="Source Title">Verified Buyer</cite></footer>
                    </blockquote>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#testimonialsCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#testimonialsCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>
</section>

<!-- FAQ Accordion + Contact CTA -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-7">
                <h3 class="fw-bold mb-3">Frequently Asked Questions</h3>
                <div class="accordion" id="faqAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqOne">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                                Are your products cruelty-free?
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="faqOne" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted">Yes — we do not test on animals and partner with certified cruelty-free manufacturers.</div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqTwo">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                Do you offer sample sizes?
                            </button>
                        </h2>
                        <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="faqTwo" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted">We offer travel and trial sizes on select products. Check the product page for availability.</div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqThree">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                How quickly will I see results?
                            </button>
                        </h2>
                        <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="faqThree" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted">Results vary by product and skin type; many customers report visible improvement within 2–4 weeks of consistent use.</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm p-4 text-center">
                    <h5 class="fw-bold">Need personalized help?</h5>
                    <p class="text-muted">Contact our skincare consultants for product recommendations tailored to your concerns.</p>
                    <a href="mailto:support@glowskin.example" class="btn btn-primary rounded-pill contact-cta"><i class="fas fa-headset me-2"></i>Contact Support</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Newsletter CTA -->
<section class="py-5 text-center">
    <div class="container">
        <h3 class="fw-bold mb-3">Join our Newsletter</h3>
        <p class="text-muted">Get exclusive offers and skincare tips. No spam — unsubscribe anytime.</p>
        <form class="d-flex justify-content-center gap-2" method="post" asp-controller="Home" asp-action="SubscribeNewsletter">
            <input name="email" type="email" class="form-control" style="max-width:420px;" placeholder="Enter your email" required />
            <button class="btn btn-primary subscribe-btn"><i class="fas fa-envelope me-2"></i>Subscribe</button>
        </form>
        @if (TempData["NewsletterResult"] != null)
        {
            <div class="alert alert-info mt-3">@TempData["NewsletterResult"]</div>
        }
    </div>
</section>
