using Microsoft.AspNetCore.Mvc;
using Frmework.Models;
using System;
using System.Collections.Generic;
using System.Linq;

namespace Frmework.Controllers
{
    public class OnlineSalesController : Controller
    {
        public IActionResult Index(string q, string platform, string orderStatus, DateTime? from, DateTime? to)
        {
            // products and opening stock (sample)
            var products = new[] {
                new { Name = "Collagen Booster Cream", SKU = "CB001", MRP = 1499m, Opening = 100, Added = 50 },
                new { Name = "Hyaluronic Acid Face Serum", SKU = "HA002", MRP = 959m, Opening = 120, Added = 30 },
                new { Name = "Niacinamide Face Serum", SKU = "NI003", MRP = 899m, Opening = 90, Added = 20 },
                new { Name = "Lustrous Gel Cream", SKU = "LG004", MRP = 1199m, Opening = 80, Added = 40 },
                new { Name = "Vitamin C Face Serum", SKU = "VC005", MRP = 999m, Opening = 110, Added = 25 }
            };

            var sales = GetSampleSales();

            // apply filters to sales list
            var filtered = sales.AsQueryable();
            if (!string.IsNullOrWhiteSpace(q)) filtered = filtered.Where(s => (s.CustomerName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) || (s.OrderId ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) || (s.ProductName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(platform) && platform != "All") filtered = filtered.Where(s => s.SellerPlatform == platform);
            if (!string.IsNullOrWhiteSpace(orderStatus) && orderStatus != "All") filtered = filtered.Where(s => s.OrderStatus == orderStatus);
            if (from.HasValue) filtered = filtered.Where(s => s.OrderDate >= from.Value.Date);
            if (to.HasValue) filtered = filtered.Where(s => s.OrderDate <= to.Value.Date);

            var vm = new OnlineSalesViewModel();

            // build product stock rows
            foreach(var p in products)
            {
                var row = new ProductStockViewModel {
                    ProductName = p.Name,
                    SKU = p.SKU,
                    MRP = p.MRP,
                    OpeningStock = p.Opening,
                    TotalAdded = p.Added
                };

                // per-platform counts
                var platforms = new[]{"Amazon","Flipkart","Meesho","MyStore","Distacart","23UForever Website","Other Online Platforms"};
                foreach(var plat in platforms) row.PlatformSold[plat] = filtered.Where(s => s.ProductName == p.Name && s.SellerPlatform==plat && (s.ReturnStatus==null || (s.ReturnStatus!="Returned" && s.ReturnStatus!="Refunded"))).Sum(s=>s.Quantity);

                row.TotalSold = filtered.Where(s => s.ProductName==p.Name && (s.ReturnStatus==null || (s.ReturnStatus!="Returned" && s.ReturnStatus!="Refunded"))).Sum(s=>s.Quantity);
                row.SalesAmount = filtered.Where(s => s.ProductName==p.Name && (s.ReturnStatus==null || (s.ReturnStatus!="Returned" && s.ReturnStatus!="Refunded"))).Sum(s=>s.NetSaleAmount);
                row.OfflineSold = 0; // placeholder
                row.RemainingStock = row.OpeningStock + row.TotalAdded - row.TotalSold - row.OfflineSold;
                var totalAvailable = row.OpeningStock + row.TotalAdded;
                row.RemainingPercent = totalAvailable>0 ? (int)(row.RemainingStock *100 / totalAvailable) : 0;
                // status
                if(row.RemainingStock<=0) row.StockStatus = "Out of Stock";
                else if(row.RemainingPercent < 20) row.StockStatus = "Critical";
                else if(row.RemainingPercent < 50) row.StockStatus = "Low Stock";
                else row.StockStatus = "Healthy";

                vm.Products.Add(row);
            }

            // platforms summary
            var platformNames = new[]{"Amazon","Flipkart","Meesho","MyStore","Distacart","23UForever Website","Other Online Platforms"};
            foreach(var plat in platformNames)
            {
                var ps = new PlatformSalesViewModel{
                    PlatformName = plat,
                    TotalOrders = filtered.Count(s=>s.SellerPlatform==plat),
                    UnitsSold = filtered.Where(s=>s.SellerPlatform==plat && (s.ReturnStatus==null || (s.ReturnStatus!="Returned" && s.ReturnStatus!="Refunded"))).Sum(s=>s.Quantity),
                    SalesAmount = filtered.Where(s=>s.SellerPlatform==plat && (s.ReturnStatus==null || (s.ReturnStatus!="Returned" && s.ReturnStatus!="Refunded"))).Sum(s=>s.NetSaleAmount)
                };
                vm.Platforms.Add(ps);
            }

            // overall summary
            vm.Sales = filtered.ToList();
            vm.TotalStock = vm.Products.Sum(p=>p.OpeningStock + p.TotalAdded);
            vm.TotalUnitsSold = vm.Products.Sum(p=>p.TotalSold);
            vm.TotalRemainingStock = vm.Products.Sum(p=>p.RemainingStock);
            vm.TotalSalesAmount = vm.Products.Sum(p=>p.SalesAmount);
            vm.TotalOnlineOrders = vm.Sales.Count;
            vm.LowStockProducts = vm.Products.Count(p=>p.StockStatus=="Low Stock");
            vm.OutOfStockProducts = vm.Products.Count(p=>p.StockStatus=="Out of Stock");

            // populate legacy view properties for compatibility
            vm.TotalOrders = vm.TotalOnlineOrders;
            vm.TotalQuantity = vm.Products.Sum(p=>p.TotalSold);
            vm.PaidAmount = vm.Sales.Where(s=>s.PaymentStatus=="Paid").Sum(s=>s.NetSaleAmount);
            vm.PendingAmount = vm.Sales.Where(s=>s.PaymentStatus=="Pending").Sum(s=>s.NetSaleAmount);
            vm.ReturnsCount = vm.Sales.Count(s=>s.ReturnStatus=="Returned" || s.ReturnStatus=="Refunded");
            vm.AmazonSales = vm.Platforms.FirstOrDefault(p=>p.PlatformName=="Amazon")?.SalesAmount ?? 0;
            vm.FlipkartSales = vm.Platforms.FirstOrDefault(p=>p.PlatformName=="Flipkart")?.SalesAmount ?? 0;
            vm.MeeshoSales = vm.Platforms.FirstOrDefault(p=>p.PlatformName=="Meesho")?.SalesAmount ?? 0;
            vm.WebsiteSales = vm.Platforms.FirstOrDefault(p=>p.PlatformName=="23UForever Website")?.SalesAmount ?? 0;

            return View("~/Views/OnlineSales/Index.cshtml", vm);
        }

