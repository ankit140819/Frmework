    public class OnlineSalesController : Controller
    {
        public IActionResult Index(string q, string platform, string orderStatus, DateTime? from, DateTime? to)
        {
            // Sample data - replace with DB queries later
            var sample = GetSampleSales();

            // simple filters
            if (!string.IsNullOrWhiteSpace(q))
            {
                sample = sample.Where(s => (s.CustomerName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                                            || (s.ProductName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                                            || (s.OrderId ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            if (!string.IsNullOrWhiteSpace(platform) && platform != "All")
            {
                sample = sample.Where(s => string.Equals(s.SellerPlatform, platform, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            if (!string.IsNullOrWhiteSpace(orderStatus) && orderStatus != "All")
            {
                sample = sample.Where(s => string.Equals(s.OrderStatus, orderStatus, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            if (from.HasValue)
                sample = sample.Where(s => s.OrderDate >= from.Value.Date).ToList();
            if (to.HasValue)
                sample = sample.Where(s => s.OrderDate <= to.Value.Date).ToList();

            var vm = new OnlineSaleViewModel();
            vm.Sales = sample;
            vm.TotalOrders = vm.Sales.Count;
            vm.TotalQuantity = vm.Sales.Sum(s => s.Quantity);
            vm.TotalSalesAmount = vm.Sales.Sum(s => s.NetSaleAmount);
            vm.PaidAmount = vm.Sales.Where(s => s.PaymentStatus == "Paid").Sum(s => s.NetSaleAmount);
            vm.PendingAmount = vm.Sales.Where(s => s.PaymentStatus == "Pending").Sum(s => s.NetSaleAmount);
            vm.ReturnsCount = vm.Sales.Count(s => s.ReturnStatus == "Returned" || s.ReturnStatus == "Refunded");

            vm.AmazonSales = vm.Sales.Where(s => s.SellerPlatform == "Amazon").Sum(s => s.NetSaleAmount);
            vm.FlipkartSales = vm.Sales.Where(s => s.SellerPlatform == "Flipkart").Sum(s => s.NetSaleAmount);
            vm.MeeshoSales = vm.Sales.Where(s => s.SellerPlatform == "Meesho").Sum(s => s.NetSaleAmount);
            vm.WebsiteSales = vm.Sales.Where(s => s.SellerPlatform == "23UForever Website").Sum(s => s.NetSaleAmount);

            return View("~/Views/OnlineSales/Index.cshtml", vm);
        }

