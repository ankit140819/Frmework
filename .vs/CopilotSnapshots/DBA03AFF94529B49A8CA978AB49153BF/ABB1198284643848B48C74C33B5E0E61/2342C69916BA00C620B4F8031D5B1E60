@model Frmework.Models.OnlineSaleViewModel
@{
    ViewData["Title"] = "Online Seller Details";
}

<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Online Seller Details</h3>
        <div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addOnlineSaleModal"><i class="fas fa-plus-circle"></i> Add Online Sale</button>
            <a class="btn btn-outline-secondary ms-2" href="#"><i class="fas fa-file-export"></i> Export</a>
        </div>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Total Sales</small>
                        <div class="h5">₹@Model.TotalSalesAmount.ToString("N0")</div>
                    </div>
                    <i class="fas fa-hand-holding-usd fs-2 text-primary"></i>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Total Orders</small>
                        <div class="h5">@Model.TotalOrders</div>
                    </div>
                    <i class="fas fa-shopping-cart fs-2 text-success"></i>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Total Quantity</small>
                        <div class="h5">@Model.TotalQuantity</div>
                    </div>
                    <i class="fas fa-boxes fs-2 text-info"></i>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Paid Amount</small>
                        <div class="h5">₹@Model.PaidAmount.ToString("N0")</div>
                    </div>
                    <i class="fas fa-credit-card fs-2 text-warning"></i>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Pending Amount</small>
                        <div class="h5">₹@Model.PendingAmount.ToString("N0")</div>
                    </div>
                    <i class="fas fa-clock fs-2 text-danger"></i>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Returns/Refunds</small>
                        <div class="h5">@Model.ReturnsCount</div>
                    </div>
                    <i class="fas fa-undo fs-2 text-secondary"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Platform breakdown -->
    <div class="row mb-3">
        <div class="col-md-3"><div class="card p-3">Amazon Sales<br/><strong>₹@Model.AmazonSales.ToString("N0")</strong></div></div>
        <div class="col-md-3"><div class="card p-3">Flipkart Sales<br/><strong>₹@Model.FlipkartSales.ToString("N0")</strong></div></div>
        <div class="col-md-3"><div class="card p-3">Meesho Sales<br/><strong>₹@Model.MeeshoSales.ToString("N0")</strong></div></div>
        <div class="col-md-3"><div class="card p-3">Website Sales<br/><strong>₹@Model.WebsiteSales.ToString("N0")</strong></div></div>
    </div>

    <!-- Filters -->
    <div class="card mb-3 p-3">
        <form class="row g-2" method="get">
            <div class="col-md-3">
                <input type="text" name="q" class="form-control" placeholder="Search (order id, customer, product)" />
            </div>
            <div class="col-md-2">
                <select name="platform" class="form-select">
                    <option>All</option>
                    <option>Amazon</option>
                    <option>Flipkart</option>
                    <option>Meesho</option>
                    <option>MyStore</option>
                    <option>Distacart</option>
                    <option>23UForever Website</option>
                    <option>Other Online Platforms</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="orderStatus" class="form-select">
                    <option>All</option>
                    <option>Processing</option>
                    <option>Shipped</option>
                    <option>Delivered</option>
                    <option>Cancelled</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="from" class="form-control" />
            </div>
            <div class="col-md-2">
                <input type="date" name="to" class="form-control" />
            </div>
            <div class="col-md-1 text-end">
                <button class="btn btn-primary">Filter</button>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Platform</th>
                        <th>Order ID</th>
                        <th>Order Date</th>
                        <th>Customer</th>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Qty</th>
                        <th>MRP</th>
                        <th>Sell Price</th>
                        <th>Discount</th>
                        <th>Platform Charges</th>
                        <th>Shipping</th>
                        <th>GST</th>
                        <th>Net</th>
                        <th>Payment</th>
                        <th>Order</th>
                        <th>Return</th>
                        <th>Settlement</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var s in Model.Sales)
                    {
                        <tr>
                            <td>@s.SellerPlatform</td>
                            <td>@s.OrderId</td>
                            <td>@s.OrderDate.ToString("yyyy-MM-dd")</td>
                            <td>@s.CustomerName</td>
                            <td>@s.ProductName</td>
                            <td>@s.SKU</td>
                            <td>@s.Quantity</td>
                            <td>₹@s.MRP.ToString("F2")</td>
                            <td>₹@s.SellingPrice.ToString("F2")</td>
                            <td>₹@s.Discount.ToString("F2")</td>
                            <td>₹@s.PlatformCharges.ToString("F2")</td>
                            <td>₹@s.ShippingCharges.ToString("F2")</td>
                            <td>₹@s.GST.ToString("F2")</td>
                            <td>₹@s.NetSaleAmount.ToString("F2")</td>
                            <td>
                                @if(s.PaymentStatus=="Paid") { <span class="badge bg-success">Paid</span> }
                                else if(s.PaymentStatus=="Pending") { <span class="badge bg-warning">Pending</span> }
                                else { <span class="badge bg-secondary">@s.PaymentStatus</span> }
                            </td>
                            <td>
                                @switch(s.OrderStatus) {
                                    case "Delivered": @:<span class="badge bg-success">Delivered</span>; break;
                                    case "Processing": @:<span class="badge bg-warning">Processing</span>; break;
                                    case "Shipped": @:<span class="badge bg-info">Shipped</span>; break;
                                    case "Cancelled": @:<span class="badge bg-danger">Cancelled</span>; break;
                                    default: @:<span class="badge bg-secondary">@s.OrderStatus</span>; break;
                                }
                            </td>
                            <td>
                                @if(s.ReturnStatus=="Returned" || s.ReturnStatus=="Refunded") { <span class="badge bg-danger">@s.ReturnStatus</span> } else { <span class="badge bg-secondary">@s.ReturnStatus</span> }
                            </td>
                            <td>
                                @if(s.SettlementAmount>0) { <div>₹@s.SettlementAmount.ToString("F2")<br/><small>@(s.SettlementDate?.ToString("yyyy-MM-dd") ?? "-")</small></div> } else { <small class="text-muted">Pending</small> }
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="#"><i class="fas fa-eye"></i></a>
                                <a class="btn btn-sm btn-outline-secondary" href="#"><i class="fas fa-edit"></i></a>
                                <a class="btn btn-sm btn-outline-danger" href="#"><i class="fas fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer d-flex justify-content-between align-items-center">
            <div>
                <small class="text-muted">Showing @Model.Sales.Count items</small>
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item disabled"><a class="page-link">«</a></li>
                    <li class="page-item active"><a class="page-link">1</a></li>
                    <li class="page-item"><a class="page-link">2</a></li>
                    <li class="page-item"><a class="page-link">3</a></li>
                    <li class="page-item"><a class="page-link">»</a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Add Online Sale Modal -->
<div class="modal fade" id="addOnlineSaleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="font-size:12px;">
            <div class="modal-header">
                <h5 class="modal-title">Add Online Sale</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label">Platform</label>
                            <select class="form-select">
                                <option>Amazon</option>
                                <option>Flipkart</option>
                                <option>Meesho</option>
                                <option>MyStore</option>
                                <option>Distacart</option>
                                <option>23UForever Website</option>
                                <option>Other Online Platforms</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Order ID</label>
                            <input class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Order Date</label>
                            <input type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Customer Name</label>
                            <input class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Product Name</label>
                            <input class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">SKU</label>
                            <input class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Quantity</label>
                            <input type="number" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Selling Price</label>
                            <input type="number" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Discount</label>
                            <input type="number" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Platform Charges</label>
                            <input type="number" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Shipping Charges</label>
                            <input type="number" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">GST</label>
                            <input type="number" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Remarks</label>
                            <textarea class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>
