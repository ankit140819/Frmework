<script>
    function toggleFAQ(element) {
        const question = element;
        const answer = element.nextElementSibling;
        const icon = question.querySelector('.faq-icon');

        // Close other FAQs
        document.querySelectorAll('.faq-answer.active').forEach(item => {
            if (item !== answer) {
                item.classList.remove('active');
                item.previousElementSibling.classList.remove('active');
                item.previousElementSibling.querySelector('.faq-icon').classList.remove('active');
            }
        });

        // Toggle current FAQ
        answer.classList.toggle('active');
        question.classList.toggle('active');    
        icon.classList.toggle('active');
    }

    function handleNewsletter(event) {
        event.preventDefault();
        const email = event.target.querySelector('input[type="email"]').value;
        alert('Thank you for subscribing! Check your email for a 15% discount code.');
        event.target.reset();
    }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>                         
<script>
    gsap.registerPlugin(ScrollTrigger);
    const box = document.getElementById("revealBox");
    const caption = document.getElementById("caption");
    const left = document.getElementById("word-left");
    const right = document.getElementById("word-right");
    const tl = gsap.timeline({
        scrollTrigger: {
            trigger: ".pin-wrap",
            start: "top top",
            end: "bottom bottom",
            scrub: 0.6,
        },
    });
    tl.to(box, {
        width: "98vw",
        height: "75vh",
        borderRadius: 0,
        ease: "none",
    }, 0, ).to(left, {
        x: "-60vw",
        opacity: 0,
        ease: "none",
    }, 0, ).to(right, {
        x: "60vw",
        opacity: 0,
        ease: "none",
    }, 0, ).to(caption, {
        opacity: 1,
        ease: "none",
    }, 0.35, ).to(caption, {
        opacity: 0,
        ease: "none",
    }, 0.85, );
</script>


