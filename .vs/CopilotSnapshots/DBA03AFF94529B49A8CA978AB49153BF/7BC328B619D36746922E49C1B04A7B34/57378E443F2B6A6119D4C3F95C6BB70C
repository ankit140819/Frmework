/* 23UForever Home Page styles (scoped under .home-page) */
:root{
  --home-bg:#fbf6f4;
  --accent:#e6cfc9;
  --accent-2:#f6e9e6;
  --muted:#8a7b75;
  --card:#fff;
  --primary:#1f1f1f;
}
.home-page{background:var(--home-bg)}
.home-hero{padding:80px 0;display:flex;align-items:center}
.home-hero .hero-left{padding-right:30px}
.home-hero h1{font-size:3rem;color:var(--primary);font-weight:700;margin-bottom:18px}
.home-hero p{color:var(--muted);font-size:1.05rem;max-width:620px}
.hero-illustration{max-width:520px;width:100%;border-radius:18px;background:linear-gradient(180deg,var(--accent-2),#fff);padding:28px}
.icon-features{display:flex;gap:18px;margin-top:28px}
.icon-features .feat{background:var(--card);padding:12px 18px;border-radius:12px;box-shadow:0 6px 18px rgba(20,20,20,0.04);font-size:0.95rem;color:var(--muted)}
.category-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:18px;margin-top:40px}
.category-item{background:linear-gradient(180deg,var(--accent-2),#fff);padding:28px;border-radius:14px;text-align:center}
.category-item img{width:72px;height:72px;border-radius:12px;display:block;margin:0 auto 12px}
.products-row{display:flex;gap:18px;margin-top:28px}
.product-card{background:var(--card);padding:18px;border-radius:12px;flex:1;box-shadow:0 8px 24px rgba(30,30,30,0.04)}
.product-card .price{font-weight:700;color:var(--primary);margin-top:8px}
.cta-strip{background:linear-gradient(90deg,#f9efe8,#fff);padding:40px;border-radius:14px;margin-top:40px;display:flex;align-items:center;justify-content:space-between}
.testimonials{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:28px}
.testimonial{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(20,20,20,0.03)}
.newsletter{background:#f5e9e7;padding:28px;border-radius:12px;margin-top:36px;text-align:center}
.reveal-box {
    left: 90px;
}
@media(max-width:1100px) {
    .category-grid {
        grid-template-columns: repeat(3,1fr)
    }

    .testimonials {
        grid-template-columns: repeat(2,1fr)
    }

    .home-hero {
        padding: 60px 0
    }
}
@media(max-width:768px){
  .home-hero{flex-direction:column;gap:18px;padding:36px 0}
  .category-grid{grid-template-columns:repeat(2,1fr)}
  .products-row{flex-direction:column}
  .testimonials{grid-template-columns:1fr}
}
