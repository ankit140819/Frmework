@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <style>

    .auth-root {
      display: flex;
      width: 100%;
      max-width: 860px;
      min-height: 540px;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,0.12);
      background: #fff;
    }

    /* ── Sidebar ── */
    .auth-side {
      width: 42%;
      background: #1a1a2e;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 2.5rem;
      overflow: hidden;
    }
    .side-orb {
      position: absolute;
      border-radius: 50%;
    }
    .orb1 { width: 260px; height: 260px; background: #534AB7; top: -60px; right: -60px; opacity: 0.35; }
    .orb2 { width: 180px; height: 180px; background: #1D9E75; bottom: 60px; left: -40px; opacity: 0.25; }
    .orb3 { width: 120px; height: 120px; background: #D85A30; top: 50%; right: 20px; opacity: 0.2; }
    .side-content { position: relative; z-index: 1; }
    .side-icon {
      width: 52px; height: 52px; border-radius: 14px;
      background: rgba(255,255,255,0.12);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 1.25rem;
      border: 1px solid rgba(255,255,255,0.18);
    }
    .side-icon i { font-size: 22px; color: #fff; }
    .side-title { font-size: 22px; font-weight: 600; color: #fff; line-height: 1.35; margin-bottom: 0.5rem; }
    .side-sub { font-size: 13px; color: rgba(255,255,255,0.6); line-height: 1.6; }
    .side-features { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 12px; }
    .feat { display: flex; align-items: center; gap: 10px; }
    .feat-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .feat span { font-size: 13px; color: rgba(255,255,255,0.7); }

    /* ── Form area ── */
    .auth-form-area {
      flex: 1;
      padding: 2.5rem 2.25rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    /* ── Tabs ── */
    .auth-tabs {
      display: flex;
      background: #f1f1f5;
      border-radius: 10px;
      padding: 4px;
      margin-bottom: 1.75rem;
    }
    .auth-tab {
      flex: 1;
      padding: 8px;
      text-align: center;
      font-size: 13px;
      font-weight: 500;
      border-radius: 7px;
      cursor: pointer;
      color: #888;
      border: none;
      background: transparent;
      transition: all 0.18s;
    }
    .auth-tab.active {
      background: #fff;
      color: #1a1a2e;
      box-shadow: 0 1px 4px rgba(0,0,0,0.1);
    }

    /* ── Panel ── */
    .panel { display: none; }
    .panel.active { display: block; }

    /* ── Fields ── */
    .field { margin-bottom: 14px; }
    .field label { display: block; font-size: 12px; font-weight: 600; color: #666; margin-bottom: 5px; letter-spacing: 0.03em; text-transform: uppercase; }
    .field-wrap { position: relative; }
    .field input {
      width: 100%; height: 42px;
      padding: 0 38px 0 12px;
      font-size: 14px;
      border: 1.5px solid #e8e8ee;
      border-radius: 10px;
      background: #fafafa;
      color: #1a1a2e;
      outline: none;
      font-family: inherit;
      transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    }
    .field input:focus {
      border-color: #534AB7;
      background: #fff;
      box-shadow: 0 0 0 3px rgba(83,74,183,0.12);
    }
    .field-icon {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      color: #aaa; cursor: pointer; font-size: 15px;
      transition: color 0.15s;
    }
    .field-icon:hover { color: #534AB7; }

    .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

    /* ── Meta row ── */
    .meta-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .remember { display: flex; align-items: center; gap: 7px; cursor: pointer; }
    .remember input[type=checkbox] { width: 15px; height: 15px; accent-color: #534AB7; cursor: pointer; }
    .remember span { font-size: 13px; color: #666; }
    .forgot { font-size: 13px; color: #534AB7; text-decoration: none; }
    .forgot:hover { text-decoration: underline; }

    /* ── Primary button ── */
    .btn-primary-auth {
      width: 100%; height: 44px;
      background: #534AB7;
      color: #fff;
      border: none;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      transition: background 0.15s, transform 0.1s;
    }
    .btn-primary-auth:hover { background: #3C3489; }
    .btn-primary-auth:active { transform: scale(0.98); }

    /* ── Divider ── */
    .divider { display: flex; align-items: center; gap: 10px; margin: 16px 0; }
    .divider-line { flex: 1; height: 1px; background: #eee; }
    .divider span { font-size: 12px; color: #bbb; }

    /* ── Social buttons ── */
    .social-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 16px; }
    .social-btn {
      height: 40px;
      border: 1.5px solid #e8e8ee;
      border-radius: 10px;
      background: #fff;
      color: #333;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      font-family: inherit;
      transition: background 0.15s, border-color 0.15s;
    }
    .social-btn:hover { background: #f9f9fb; border-color: #ccc; }
    .google-icon { width: 16px; height: 16px; }

    /* ── Switch text ── */
    .switch-text { text-align: center; font-size: 13px; color: #999; }
    .switch-text a { color: #534AB7; font-weight: 600; text-decoration: none; cursor: pointer; }
    .switch-text a:hover { text-decoration: underline; }

    /* ── Password strength ── */
    .strength-bar { height: 4px; border-radius: 2px; background: #eee; overflow: hidden; margin-top: 7px; }
    .strength-fill { height: 100%; width: 0; border-radius: 2px; transition: width 0.25s, background 0.25s; }
    .pwd-hints { display: flex; gap: 10px; margin-top: 7px; flex-wrap: wrap; }
    .hint { font-size: 11px; color: #bbb; display: flex; align-items: center; gap: 4px; transition: color 0.2s; }
    .hint.ok { color: #0F6E56; }
    .hint i { font-size: 10px; }

  </style>

<div class="container">
    <div class="row">
        <div class="col-lg-12 mt-5">
            <div class="row align-items-center justify-content-center">
                <div class="col-lg-9">
                    <div class="auth-root">
                      <aside class="auth-side">
                        <div class="side-orb orb1"></div>
                        <div class="side-orb orb2"></div>
                        <div class="side-orb orb3"></div>
                        <div class="side-content">
                          <div class="side-icon"><i class="fa-solid fa-shield-halved"></i></div>
                          <div class="side-title">Your account,<br>your world.</div>
                          <div class="side-sub">Secure, fast, and always with you.</div>
                          <div class="side-features">
                            <div class="feat"><div class="feat-dot" style="background:#AFA9EC"></div><span>End-to-end encrypted sessions</span></div>
                            <div class="feat"><div class="feat-dot" style="background:#5DCAA5"></div><span>Instant order tracking</span></div>
                            <div class="feat"><div class="feat-dot" style="background:#F0997B"></div><span>Saved preferences &amp; deals</span></div>
                          </div>
                        </div>
                      </aside>
                     <div class="auth-form-area">
                    <div class="auth-tabs">
                        <button class="auth-tab active" id="tab-login" onclick="switchTab('login')">Sign in</button>
                        <button class="auth-tab" id="tab-signup" onclick="switchTab('signup')">Create account</button>
                    </div>
                        <div class="panel active" id="panel-login">
                        <form id="loginForm" asp-controller="Account" asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                            <div class="field">
                            <label>Email address</label>
                            <div class="field-wrap">
                                <input type="email" name="email" placeholder="you@example.com" autocomplete="email" />
                                <i class="fa-regular fa-envelope field-icon"></i>
                            </div>
                            </div>
                            <div class="field">
                            <label>Password</label>
                            <div class="field-wrap">
                                <input type="password" name="password" id="login-pw" placeholder="••••••••" autocomplete="current-password" />
                                <i class="fa-regular fa-eye field-icon" onclick="togglePw('login-pw', this)" title="Toggle visibility"></i>
                            </div>
                            </div>
                            <div class="meta-row">
                            <label class="remember">
                                <input type="checkbox" name="rememberMe" />
                                <span>Remember me</span>
                            </label>
                            <a href="#" class="forgot">Forgot password?</a>
                            </div>
                            <button type="button" id="loginSubmitBtn" class="btn-primary-auth" onclick="submitLogin();">
                            <i class="fa-solid fa-arrow-right-to-bracket"></i>
                            Sign in
                            </button>
                            </form>
                            <div class="divider">
                            <div class="divider-line"></div><span>or continue with</span><div class="divider-line"></div>
                            </div>
                            <div class="social-row">
                            <button type="button" class="social-btn">
                                <svg class="google-icon" viewBox="0 0 24 24">
                                <path fill="#4285F4" d="M23.745 12.27c0-.79-.07-1.54-.19-2.27h-11.3v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"/>
                                <path fill="#34A853" d="M12.255 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96h-3.98v3.09C3.515 21.3 7.565 24 12.255 24z"/>
                                <path fill="#FBBC05" d="M5.525 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62h-3.98a11.86 11.86 0 0 0 0 10.76l3.98-3.09z"/>
                                <path fill="#EA4335" d="M12.255 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C18.205 1.19 15.495 0 12.255 0c-4.69 0-8.74 2.7-10.71 6.62l3.98 3.09c.95-2.85 3.6-4.96 6.73-4.96z"/>
                                </svg>
                                Google
                            </button>
                            <button type="button" class="social-btn">
                                <i class="fa-brands fa-facebook" style="color:#1877f2; font-size:17px;"></i>
                                Facebook
                            </button>
                            </div>
                            <div class="switch-text">
                            Don't have an account? <a onclick="switchTab('signup')">Sign up free</a>
                            </div>
                        </div>
                        <div class="panel" id="panel-signup">
                            <form asp-controller="Account" asp-action="Index" method="post">
                            @Html.AntiForgeryToken()
                                <div class="row2">
                                <div class="field">
                                    <label>First name</label>
                                    <div class="field-wrap">
                                    <input type="text" name="firstName" placeholder="Alex" autocomplete="given-name" />
                                    </div>
                                </div>
                                <div class="field">
                                    <label>Last name</label>
                                    <div class="field-wrap">
                                    <input type="text" name="lastName" placeholder="Morgan" autocomplete="family-name" />
                                    </div>
                                </div>
                                </div>
                                <div class="field">
                                <label>Email address</label>
                                <div class="field-wrap">
                                    <input type="email" name="email" placeholder="you@example.com" autocomplete="email" />
                                    <i class="fa-regular fa-envelope field-icon"></i>
                                </div>
                                </div>
                                <div class="field">
                                <label>Password</label>
                                <div class="field-wrap">
                                    <input type="password" name="password" id="reg-pw" placeholder="••••••••" autocomplete="new-password" oninput="checkStrength(this.value)" />
                                    <i class="fa-regular fa-eye field-icon" onclick="togglePw('reg-pw', this)" title="Toggle visibility"></i>
                                </div>
                                <div class="strength-bar"><div class="strength-fill" id="str-fill"></div></div>
                                <div class="pwd-hints">
                                    <div class="hint" id="h-len"><i class="fa-solid fa-circle"></i> 8+ chars</div>
                                    <div class="hint" id="h-up"><i class="fa-solid fa-circle"></i> Uppercase</div>
                                    <div class="hint" id="h-num"><i class="fa-solid fa-circle"></i> Number</div>
                                    <div class="hint" id="h-sym"><i class="fa-solid fa-circle"></i> Symbol</div>
                                </div>
                                </div>
                                <div class="field">
                                <label>Confirm password</label>
                                <div class="field-wrap">
                                    <input type="password" name="confirmPassword" id="reg-pw2" placeholder="••••••••" autocomplete="new-password" />
                                    <i class="fa-regular fa-eye field-icon" onclick="togglePw('reg-pw2', this)" title="Toggle visibility"></i>
                                </div>
                                </div>
                                <button type="submit" class="btn-primary-auth">
                                <i class="fa-solid fa-user-plus"></i>
                                Create account
                                </button>
                                </form>
                                <div class="divider">
                                <div class="divider-line"></div><span>or continue with</span><div class="divider-line"></div>
                                </div>
                                <div class="social-row">
                                <button type="button" class="social-btn">
                                    <svg class="google-icon" viewBox="0 0 24 24">
                                    <path fill="#4285F4" d="M23.745 12.27c0-.79-.07-1.54-.19-2.27h-11.3v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"/>
                                    <path fill="#34A853" d="M12.255 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96h-3.98v3.09C3.515 21.3 7.565 24 12.255 24z"/>
                                    <path fill="#FBBC05" d="M5.525 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62h-3.98a11.86 11.86 0 0 0 0 10.76l3.98-3.09z"/>
                                    <path fill="#EA4335" d="M12.255 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C18.205 1.19 15.495 0 12.255 0c-4.69 0-8.74 2.7-10.71 6.62l3.98 3.09c.95-2.85 3.6-4.96 6.73-4.96z"/>
                                    </svg>
                                    Google
                                </button>
                                <button type="button" class="social-btn">
                                    <i class="fa-brands fa-facebook" style="color:#1877f2; font-size:17px;"></i>
                                    Facebook
                                </button>
                                </div>
                               <div class="switch-text">
                                Already have an account? <a onclick="switchTab('login')">Sign in</a>
                             </div>
                         </div>
                     </div>
                  </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function switchTab(tab) {
        debugger;
      document.getElementById('tab-login').classList.toggle('active', tab === 'login');
      document.getElementById('tab-signup').classList.toggle('active', tab === 'signup');
      document.getElementById('panel-login').classList.toggle('active', tab === 'login');
      document.getElementById('panel-signup').classList.toggle('active', tab === 'signup');
    }

    function togglePw(id, icon) {
      var el = document.getElementById(id);
      if (!el) return;
      var show = el.type === 'password';
      el.type = show ? 'text' : 'password';
      icon.className = (show ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye') + ' field-icon';
    }

    function checkStrength(val) {
      var fill   = document.getElementById('str-fill');
      var hLen   = document.getElementById('h-len');
      var hUp    = document.getElementById('h-up');
      var hNum   = document.getElementById('h-num');
      var hSym   = document.getElementById('h-sym');

      var hasLen = val.length >= 8;
      var hasUp  = /[A-Z]/.test(val);
      var hasNum = /[0-9]/.test(val);
      var hasSym = /[^A-Za-z0-9]/.test(val);
      var score  = (hasLen ? 25 : 0) + (hasUp ? 25 : 0) + (hasNum ? 25 : 0) + (hasSym ? 25 : 0);

      fill.style.width      = score + '%';
      fill.style.background = score < 26 ? '#E24B4A' : score < 51 ? '#EF9F27' : score < 76 ? '#facc15' : '#1D9E75';

      function setHint(el, ok) {
        el.classList.toggle('ok', ok);
        el.querySelector('i').className = ok ? 'fa-solid fa-circle-check' : 'fa-solid fa-circle';
      }
      setHint(hLen, hasLen);
      setHint(hUp,  hasUp);
      setHint(hNum, hasNum);
      setHint(hSym, hasSym);
    }

    // Ensure login submit works even if other scripts interfere
    function submitLogin() {
      var form = document.getElementById('loginForm');
      if (!form) return;
      var email = (form.querySelector('input[name="email"]') || {}).value || '';
      var pw = (form.querySelector('input[name="password"]') || {}).value || '';
      if (!email || !pw) {
        alert('Please enter both email and password.');
        return;
      }
      form.submit();
    }
</script>