html {
  font-size: 14px;
}

/* Dashboard global overrides to ensure consistent look */
:root {
  --dashboard-bg: #f7f8fa;
  --sidebar-bg: #17191e;
  --main-padding: 28px 34px;
}

@media (min-width: 768px) {
  html {
    font-size: 16px;
  }
}

.btn:focus, .btn:active:focus, .btn-link.nav-link:focus, .form-control:focus, .form-check-input:focus {
  box-shadow: 0 0 0 0.1rem white, 0 0 0 0.25rem #258cfb;
}

html {
  position: relative;
  min-height: 100%;
}

body {
  margin-bottom: 60px;
  background: var(--dashboard-bg);
}

/* Ensure main content doesn't hide behind the fixed footer */
main[role="main"]{
  padding-bottom:60px; /* default, will be adjusted by inline script setting --footer-height if needed */
  padding: var(--main-padding);
}

/* Ensure that pages render correctly when header/sidebar injected */
.app-shell .main {
  margin-left:252px; /* matches dashboard sidebar width */
}

@media(max-width:1000px){
  .app-shell .main{ margin-left:70px }
}

@media (max-width:650px){
  footer{ position:static; }
  main[role="main"]{ padding-bottom:40px; }
}

.form-floating > .form-control-plaintext::placeholder, .form-floating > .form-control::placeholder {
  color: var(--bs-secondary-color);
  text-align: end;
}

.form-floating > .form-control-plaintext:focus::placeholder, .form-floating > .form-control:focus::placeholder {
  text-align: start;
}