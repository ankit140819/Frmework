@model InventoryDashboardMvc.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<style>
    footer{display:none;}
</style>

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-icon">DB</div>
            <div>
                <strong>Admin</strong>
                <span>Dashboard</span>
            </div>
            <button class="collapse-toggle" aria-label="Toggle sidebar" title="Toggle sidebar">☰</button>
        </div>
        <nav>
            <a class="nav-item active" href="@Url.Action("Index", "Dashboard")"><i class="fas fa-tachometer-alt"></i><span>Dashboard</span></a>
            <a class="nav-item"
               href="@Url.Page("/ProductInventory", new { area = "ProductInventory" })">
                <i class="fa-solid fa-rectangle-list"></i>
                <span>Product Inventory</span>
            </a>
            <a class="nav-item" href="@Url.Page("/Orders", new { area = "Admin" })"><i class="fas fa-shopping-basket"></i><span>Orders</span></a>
            <a class="nav-item" href="@Url.Page("/Products", new { area = "Admin" })"><i class="fas fa-box"></i><span>Products</span></a>
            <a class="nav-item" href="@Url.Page("/Customers", new { area = "Admin" })"><i class="fas fa-users"></i><span>Customers</span></a>
            <a class="nav-item" href="@Url.Page("/Addresses", new { area = "Admin" })"><i class="fas fa-map-marker-alt"></i><span>Addresses</span></a>
            <a class="nav-item" href="@Url.Page("/Reports", new { area = "Admin" })"><i class="fas fa-chart-bar"></i><span>Reports</span></a>
        </nav>

        <div class="sidebar-footer">
            <div class="admin-avatar">A</div>
            <div>
                <span>Admin</span>
                <small>manage site</small>
            </div>
        </div>
        <script>
            (function(){
                const sidebar = document.querySelector('.sidebar');
                const main = document.querySelector('.main');
                const toggle = document.querySelector('.collapse-toggle');

                if(!sidebar || !main || !toggle) return;

                const collapsed = localStorage.getItem('dashboard.sidebar.collapsed') === '1';
                if(collapsed){
                    sidebar.classList.add('collapsed');
                    main.classList.add('collapsed');
                }

                toggle.addEventListener('click', function(e){
                    e.preventDefault();
                    const isCollapsed = sidebar.classList.toggle('collapsed');
                    main.classList.toggle('collapsed');
                    localStorage.setItem('dashboard.sidebar.collapsed', isCollapsed ? '1' : '0');
                });

                function updateHeaderHeight(){
                    try{
                        const header = document.querySelector('header');
                        const h = header ? header.offsetHeight : 0;
                        document.documentElement.style.setProperty('--dashboard-header-height', h + 'px');
                    }catch(_){ document.documentElement.style.setProperty('--dashboard-header-height', '0px'); }
                }
                updateHeaderHeight();
                window.addEventListener('resize', function(){
                    clearTimeout(window._dashHeaderResize);
                    window._dashHeaderResize = setTimeout(updateHeaderHeight, 120);
                });

                try{
                    const path = location.pathname.toLowerCase();
                    document.querySelectorAll('.sidebar nav a.nav-item').forEach(a=>{
                        try{
                            const url = new URL(a.href, location.origin);
                            const hrefPath = url.pathname.toLowerCase();
                            if(path === hrefPath || path.indexOf(hrefPath) === 0 && hrefPath !== '/'){
                                a.classList.add('active');
                            } else {
                                a.classList.remove('active');
                            }
                        }catch(_){ }
                    });
                }catch(_){ }
            })();
        </script>
    </aside>

    <div class="main">
        <section class="content">
    <div class="welcome">
        <div>
            <h2>Good evening, Admin</h2>
            <p>Here’s what’s happening with your inventory and sales today.</p>
        </div>
        <button class="date-btn">September 01, 2026 ▾</button>
    </div>

    <div class="cards">
        <div class="metric-card">
            <div class="metric-top"><span>Total Products</span><b>▣</b></div>
            <strong>@Model.TotalProducts</strong>
            <small class="up">↑ 12% <em>vs last month</em></small>
        </div>
        <div class="metric-card">
            <div class="metric-top"><span>Available Stock</span><b>▤</b></div>
            <strong>@Model.TotalStock.ToString("N0")</strong>
            <small class="up">↑ 8.4% <em>stock units</em></small>
        </div>
        <div class="metric-card warning">
            <div class="metric-top"><span>Low Stock</span><b>!</b></div>
            <strong>@Model.LowStockProducts</strong>
            <small class="down">Needs attention <em>reorder soon</em></small>
        </div>
        <div class="metric-card">
            <div class="metric-top"><span>Total Revenue</span><b>₹</b></div>
            <strong>₹@Model.TotalRevenue.ToString("N0")</strong>
            <small class="up">↑ 18.6% <em>vs last month</em></small>
        </div>
    </div>

    <div class="grid-two">
        <div class="panel chart-panel">
            <div class="panel-head">
                <div><h3>Sales Overview</h3><p>Online vs Offline sales</p></div>
                <select><option>Last 7 months</option><option>Last 30 days</option></select>
            </div>
            <canvas id="salesChart"></canvas>
            <div class="legend">
                <span><i class="dot online"></i> Online</span>
                <span><i class="dot offline"></i> Offline</span>
            </div>
        </div>

        <div class="panel">
            <div class="panel-head">
                <div><h3>Stock by Channel</h3><p>Current stock distribution</p></div>
                <button class="more">•••</button>
            </div>
            <canvas id="channelChart"></canvas>
            <div class="channel-list">
                <div><span>Own Website</span><b>320 units</b></div>
                <div><span>Amazon / Flipkart</span><b>280 units</b></div>
                <div><span>Distributors</span><b>390 units</b></div>
                <div><span>Retailers</span><b>180 units</b></div>
                <div><span>Salon / Spa / Wholesale</span><b>70 units</b></div>
            </div>
        </div>
    </div>

    <div class="grid-three">
        <div class="panel compact">
            <div class="panel-head"><div><h3>Online Sales</h3><p>All marketplaces</p></div><span class="trend">↑ 16%</span></div>
            <strong class="big-value">₹@Model.OnlineSales.ToString("N0")</strong>
            <div class="mini-bars"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <div class="substats"><span>Orders <b>428</b></span><span>Units <b>612</b></span></div>
        </div>
        <div class="panel compact">
            <div class="panel-head"><div><h3>Offline Sales</h3><p>B2B & retail partners</p></div><span class="trend">↑ 21%</span></div>
            <strong class="big-value">₹@Model.OfflineSales.ToString("N0")</strong>
            <div class="mini-bars offline-bars"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <div class="substats"><span>Partners <b>@(Model.Distributors + Model.Retailers)</b></span><span>Units <b>628</b></span></div>
        </div>
        <div class="panel compact">
            <div class="panel-head"><div><h3>Outstanding</h3><p>Pending partner payments</p></div><span class="alert">Due</span></div>
            <strong class="big-value">₹@Model.OutstandingAmount.ToString("N0")</strong>
            <div class="progress"><span style="width:62%"></span></div>
            <div class="substats"><span>Collected <b>62%</b></span><span>Due <b>38%</b></span></div>
        </div>
    </div>

    <div class="panel table-panel">
        <div class="panel-head">
            <div><h3>Product Inventory</h3><p>Current stock and sales by product</p></div>
            <button class="outline-btn">View All Inventory →</button>
        </div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>PRODUCT</th><th>SKU</th><th>PRICE</th><th>AVAILABLE</th><th>SOLD</th><th>STOCK STATUS</th><th></th></tr></thead>
                <tbody>
                @foreach (var p in Model.Products)
                {
                    var status = p.Stock < 100 ? "Low Stock" : "In Stock";
                    <tr>
                        <td><div class="product-cell"><div class="product-img">@p.Name.Substring(0,1)</div><b>@p.Name</b></div></td>
                        <td>@p.Sku</td>
                        <td>₹@p.Price.ToString("N0")</td>
                        <td><strong>@p.Stock</strong></td>
                        <td>@p.Sold</td>
                        <td><span class="status @(status == "Low Stock" ? "low" : "good")">@status</span></td>
                        <td><button class="more">•••</button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
        </section>
    </div>
</div>
