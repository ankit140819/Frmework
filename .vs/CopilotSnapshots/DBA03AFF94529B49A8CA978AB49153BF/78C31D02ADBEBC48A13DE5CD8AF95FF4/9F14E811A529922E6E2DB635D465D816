.product-details-page {
    --detail-ink: #302b2b;
    --detail-muted: #806f6c;
    --detail-rose: #c98d84;
    --detail-blush: #f8ece9;
    --detail-line: #eee0dc;
    color: var(--detail-ink);
    padding-bottom: 70px;
}

.product-details-page .breadcrumb { font-size: .78rem; margin-bottom: 1.5rem !important; }
.product-details-page .breadcrumb a { color: var(--detail-rose); }
.product-details-page .breadcrumb-item.active { color: var(--detail-muted); }
.product-details-page .card { border: 1px solid var(--detail-line); border-radius: 18px; box-shadow: 0 10px 28px rgba(80,52,48,.06); }
.product-details-page #productGallery { background: #fff; padding: 1.25rem !important; }
.product-details-page .main-image {
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: radial-gradient(circle at center, #fff 0 35%, #f9eeeb 100%);
}
.product-details-page #mainImage { max-width: 90%; object-fit: contain; transition: transform .35s ease; }
.product-details-page .main-image:hover #mainImage { transform: scale(1.04); }
.product-details-page #thumbContainer { overflow-x: auto; justify-content: center; padding: 3px; }
.product-details-page #thumbContainer .thumb { flex: 0 0 72px; border: 1px solid var(--detail-line); background: #fff; border-radius: 11px; padding: 5px; }
.product-details-page #thumbContainer .thumb:hover { border-color: var(--detail-rose); box-shadow: 0 4px 12px rgba(201,141,132,.18); }
.product-details-page .detail-feature-card { min-height: 112px; background: #fffaf8; box-shadow: none; transition: transform .2s ease, background .2s ease; }
.product-details-page .detail-feature-card:hover { transform: translateY(-3px); background: var(--detail-blush); }
.product-details-page .detail-feature-card i { color: var(--detail-rose) !important; font-size: 1.45rem; }
.product-details-page .detail-feature-card .small { color: var(--detail-muted) !important; }
.product-details-page .purchase-panel { position: sticky; top: 95px; }
.product-details-page .purchase-panel h2 { font-family: Georgia, "Times New Roman", serif; font-size: clamp(2rem, 3.2vw, 3rem); font-weight: 400; line-height: 1.08; }
.product-details-page .feature-badge { background: var(--detail-blush); border: 1px solid #e8c5bf; color: #a76e66; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
.product-details-page #amount { font-size: 1.8rem; font-weight: 600; color: var(--detail-ink) !important; }
.product-details-page .offer-banner { display: flex; align-items: center; gap: 9px; width: fit-content; padding: .55rem .8rem; border-radius: 8px; background: #fff3e1; color: #986a32; font-size: .8rem; }
.product-details-page .offer-banner i { color: #c78936; }
.product-details-page .offer-banner small { color: #aa8560; }
.product-details-page .purchase-panel .badge.bg-light { background: #fffaf8 !important; border: 1px solid var(--detail-line); color: var(--detail-muted) !important; font-size: .72rem !important; font-weight: 500; padding: .55rem .7rem; }
.product-details-page .quantity-row label { color: var(--detail-muted); font-size: .82rem; font-weight: 600; }
.product-details-page #qty { width: 58px !important; border-color: var(--detail-line); border-radius: 8px; }
.product-details-page .quantity-row button { width: 32px; height: 32px; border-radius: 50%; color: var(--detail-rose); }
.product-details-page .purchase-actions .btn { min-height: 46px; border-radius: 9px !important; font-size: .8rem; font-weight: 600; letter-spacing: .02em; }
.product-details-page .btn-cta { background: var(--detail-ink); color: #fff; }
.product-details-page .btn-cta:hover { background: var(--detail-rose); color: #fff; }
.product-details-page .purchase-actions .btn-outline-dark:hover { background: var(--detail-blush); border-color: var(--detail-rose); color: var(--detail-ink); }
.product-details-page h5, .product-details-page h6 { font-family: Georgia, "Times New Roman", serif; font-weight: 400; }
.product-details-page .accordion-item { border-color: var(--detail-line); border-radius: 12px; overflow: hidden; }
.product-details-page .accordion-button { color: var(--detail-ink); background: #fffaf8; box-shadow: none; }
.product-details-page .accordion-button:not(.collapsed) { color: #a76e66; background: var(--detail-blush); }
.product-details-page + .bg-light { background: #fdf7f5 !important; }
.product-details-page + .bg-light .bg-white { border: 1px solid var(--detail-line); border-radius: 14px; transition: transform .2s ease, box-shadow .2s ease; }
.product-details-page + .bg-light .bg-white:hover { transform: translateY(-4px); box-shadow: 0 10px 22px rgba(80,52,48,.08) !important; }

@media (max-width: 991.98px) {
    .product-details-page .purchase-panel { position: static; }
    .product-details-page .main-image { min-height: 360px; }
}

@media (max-width: 575.98px) {
    .product-details-page { margin-top: 1.5rem !important; }
    .product-details-page .main-image { min-height: 300px; }
    .product-details-page .purchase-actions { flex-direction: column; }
    .product-details-page .purchase-actions .btn { width: 100%; }
}