@model List<Frmework.Models.Youth>
@{ ViewData["Title"] = "Products"; }
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

<div class="container my-5">
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-0">Explore Products</h2>
            <p class="text-muted">Curated selection of our best items — modern, clean and easy to browse.</p>
        </div>
        <div class="col-md-4 text-md-end">
            <small class="text-muted">@Model.Count item(s)</small>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3">
            <div class="card sticky-top" style="top:100px">
                <div class="card-body">
                    <h5 class="card-title">Refine</h5>
                    <form method="get" asp-action="Products" asp-controller="Home">
                        <div class="mb-3">
                            <label class="form-label small text-uppercase">Search</label>
                            <input type="search" name="q" value="@ViewBag.SearchQuery" class="form-control form-control-sm" placeholder="Product name or description">
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label small">Min</label>
                                <input type="number" step="0.01" name="minPrice" class="form-control form-control-sm" />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label small">Max</label>
                                <input type="number" step="0.01" name="maxPrice" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small">Sort</label>
                            <select name="sort" class="form-select form-select-sm">
                                <option value="">Recommended</option>
                                <option value="price_asc">Price: Low to High</option>
                                <option value="price_desc">Price: High to Low</option>
                            </select>
                        </div>
                        <div class="d-grid">
                            <button class="btn btn-primary btn-sm">Apply filters</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="row g-4">
                @foreach (var p in Model)
                {
                    <div class="col-sm-6 col-md-4">
                        <div class="card product-card h-100 border-0 shadow-sm">
                            <div class="position-relative overflow-hidden" style="height:220px">
                                <img src="~/images/@(p.Product_Id).png" class="w-100 h-100 object-fit-cover" alt="@p.Product_Name" />
                                <div class="product-badge position-absolute top-0 end-0 m-2">
                                    <span class="badge bg-light text-dark">New</span>
                                </div>
                                <div class="product-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-end p-3">
                                    <div class="w-100 d-flex justify-content-between">
                                        <a asp-action="Product_Details" asp-route-id="@p.Product_Id" class="btn btn-sm btn-light" title="View details"><i class="fa fa-eye"></i></a>
                                        <button class="btn btn-sm btn-primary" data-id="@p.Product_Id" data-name="@p.Product_Name" data-price="@p.Product_Amount" onclick="openQuickView(this)"><i class="fa fa-search"></i> Quick view</button>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title mb-1">@p.Product_Name</h6>
                                <p class="text-muted small mb-2">@p.Short_Description</p>
                                <div class="mt-auto d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="text-primary fw-bold fs-5">₹ @p.Product_Amount</div>
                                        <div class="text-muted small">Inclusive of all taxes</div>
                                    </div>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="AddToCart" asp-route-Product_Id="@p.Product_Id" asp-route-productName="@p.Product_Name" asp-route-selectedQty="1" asp-route-selectedTotalPrice="@p.Product_Amount" class="btn btn-outline-primary">Add</a>
                                        <a asp-action="Product_Details" asp-route-id="@p.Product_Id" class="btn btn-primary">Buy</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Quick View Modal -->
<div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-md-6">
                        <img id="qvImage" src="" class="img-fluid rounded" alt="">
                    </div>
                    <div class="col-md-6">
                        <h4 id="qvName"></h4>
                        <p id="qvDesc" class="text-muted"></p>
                        <div class="fw-bold text-primary fs-4" id="qvPrice"></div>
                        <div class="mt-3">
                            <a id="qvDetails" class="btn btn-outline-primary me-2">View details</a>
                            <a id="qvAdd" class="btn btn-primary">Add to cart</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .object-fit-cover { object-fit: cover; }
    .product-card .product-overlay { background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.45) 100%); opacity:0; transition: opacity .25s ease; }
    .product-card:hover .product-overlay { opacity: 1; }
    .product-badge .badge { font-weight:700; }
    .product-card img { transition: transform .35s ease; }
    .product-card:hover img { transform: scale(1.04); }
    .sticky-top { top: 80px; }
</style>

<script>
    function openQuickView(btn) {
        var id = btn.getAttribute('data-id');
        var name = btn.getAttribute('data-name');
        var price = btn.getAttribute('data-price');
        document.getElementById('qvName').innerText = name;
        document.getElementById('qvPrice').innerText = '₹ ' + price;
        document.getElementById('qvImage').src = '/images/' + id + '.png';
        document.getElementById('qvDesc').innerText = '';
        document.getElementById('qvDetails').href = '/Home/Product_Details?id=' + encodeURIComponent(id);
        document.getElementById('qvAdd').href = '/Home/AddToCart?Product_Id=' + encodeURIComponent(id) + '&productName=' + encodeURIComponent(name) + '&selectedQty=1&selectedTotalPrice=' + encodeURIComponent(price);
        var modal = new bootstrap.Modal(document.getElementById('quickViewModal'));
        modal.show();
    }
</script>
