@model List<Frmework.Models.Youth>
@{ ViewData["Title"] = "Products"; }
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

<div class="container my-5">
    <div class="row">
        <div class="col-lg-3">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Filters</h5>
                    <form method="get" asp-action="Products" asp-controller="Home">
                        <div class="mb-3">
                            <label class="form-label">Price min</label>
                            <input type="number" step="0.01" name="minPrice" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Price max</label>
                            <input type="number" step="0.01" name="maxPrice" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Sort</label>
                            <select name="sort" class="form-select">
                                <option value="">Default</option>
                                <option value="price_asc">Price: Low to High</option>
                                <option value="price_desc">Price: High to Low</option>
                            </select>
                        </div>
                        <div class="d-grid">
                            <button class="btn btn-primary">Apply</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-body text-center">
                    <h6>Categories</h6>
                    <p class="text-muted">(Add categories in DB and filter server-side)</p>
                    <a class="btn btn-outline-secondary btn-sm me-1" href="#">All</a>
                </div>
            </div>
        </div>
        <div class="col-lg-9">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="mb-0">Products</h3>
                <div>
                    <small class="text-muted">@Model.Count item(s)</small>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var p in Model)
                {
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm">
                            <img src="~/images/@(p.Product_Id).png" class="card-img-top object-fit-cover" style="height:200px;" alt="@p.Product_Name">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@p.Product_Name</h5>
                                <p class="text-muted small mb-2">@p.Short_Description</p>
                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong class="fs-5">₹ @p.Product_Amount</strong>
                                    </div>
                                    <div>
                                        <a asp-action="Product_Details" asp-route-id="@p.Product_Id" class="btn btn-outline-primary btn-sm me-2">View</a>
                                        <a asp-action="AddToCart" asp-route-Product_Id="@p.Product_Id" asp-route-productName="@p.Product_Name" asp-route-selectedQty="1" asp-route-selectedTotalPrice="@p.Product_Amount" class="btn btn-primary btn-sm">Add</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
.card-img-top.object-fit-cover { object-fit: cover; }
</style>
