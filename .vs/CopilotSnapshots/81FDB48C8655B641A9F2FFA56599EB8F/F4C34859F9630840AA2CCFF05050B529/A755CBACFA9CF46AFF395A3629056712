@model List<Frmework.Models.Youth>
@{ ViewData["Title"] = "Products"; }
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

<div class="container my-5">
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h1 class="display-6 fw-bold">Shop the Collection</h1>
            <p class="text-muted mb-0">Hand-picked, science-backed products for your skin. Fast shipping · Secure payment</p>
        </div>
        <div class="col-md-4 text-md-end">
            <form class="d-flex justify-content-end" method="get" asp-action="Products" asp-controller="Home">
                <input name="q" class="form-control form-control-sm me-2" style="max-width:260px" placeholder="Search products..." value="@ViewBag.SearchQuery" />
                <button class="btn btn-primary btn-sm"><i class="fa fa-search"></i></button>
            </form>
        </div>
    </div>

    <div class="row">
        <aside class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm sticky-top p-3" style="top:100px">
                <h6 class="mb-3">Filters</h6>
                <form method="get" asp-action="Products" asp-controller="Home">
                    <div class="mb-3">
                        <label class="form-label small">Price range</label>
                        <div class="d-flex gap-2">
                            <input type="number" name="minPrice" class="form-control form-control-sm" placeholder="Min" />
                            <input type="number" name="maxPrice" class="form-control form-control-sm" placeholder="Max" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Sort</label>
                        <select name="sort" class="form-select form-select-sm">
                            <option value="">Recommended</option>
                            <option value="price_asc">Price: Low to High</option>
                            <option value="price_desc">Price: High to Low</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Categories</label>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-outline-secondary btn-sm" href="#">All</a>
                            <a class="btn btn-outline-secondary btn-sm" href="#">Skincare</a>
                            <a class="btn btn-outline-secondary btn-sm" href="#">Serums</a>
                            <a class="btn btn-outline-secondary btn-sm" href="#">Creams</a>
                        </div>
                    </div>
                    <div class="d-grid">
                        <button class="btn btn-primary btn-sm">Apply</button>
                    </div>
                </form>
            </div>
        </aside>

        <section class="col-lg-9">
            <div class="row g-4">
                @foreach (var p in Model)
                {
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="card product-card h-100 border-0 shadow" style="border-radius:12px; overflow:hidden">
                            <div class="position-relative" style="height:220px; background:linear-gradient(180deg, #fff, #f8f9fa);">
                                <img loading="lazy" onerror="this.onerror=null;this.src='/images/placeholder.png'" src="~/images/@(p.Product_Id).png" class="w-100 h-100 object-fit-cover" alt="@p.Product_Name" />
                                <div class="badge position-absolute top-0 start-0 m-3 bg-white text-dark shadow-sm">New</div>
                                <button class="btn btn-sm btn-light position-absolute top-0 end-0 m-3" title="Add to wishlist" onclick="toggleWishlist(this, '@p.Product_Id')">
                                    <i class="fa fa-heart"></i>
                                </button>
                                <div class="product-overlay position-absolute bottom-0 start-0 w-100 p-3" style="background:linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,0.25))">
                                    <div class="d-flex justify-content-between">
                                        <a asp-action="Product_Details" asp-route-id="@p.Product_Id" class="btn btn-sm btn-outline-light">Details</a>
                                        <button class="btn btn-sm btn-primary" data-id="@p.Product_Id" data-name="@p.Product_Name" data-price="@p.Product_Amount" data-desc="@p.Full_Description" onclick="openQuickView(this)">Quick view</button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="mb-1" style="font-size:1rem">@p.Product_Name</h5>
                                <div class="d-flex align-items-center mb-2">
                                    <div class="me-2 text-warning">★★★★★</div>
                                    <small class="text-muted">(4.8)</small>
                                </div>
                                <p class="text-muted small mb-3 text-truncate">@p.Short_Description</p>
                                <div class="d-flex align-items-center justify-content-between mt-auto">
                                    <div>
                                        <div class="fw-bold fs-5 text-primary">₹ @p.Product_Amount</div>
                                        <small class="text-muted">Inclusive of taxes</small>
                                    </div>
                                    <div class="btn-group">
                                        <a asp-action="AddToCart" asp-route-Product_Id="@p.Product_Id" asp-route-productName="@p.Product_Name" asp-route-selectedQty="1" asp-route-selectedTotalPrice="@p.Product_Amount" class="btn btn-outline-primary btn-sm">Add</a>
                                        <a asp-action="Product_Details" asp-route-id="@p.Product_Id" class="btn btn-primary btn-sm">Buy</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Simple pagination (visual only, replace with server-side logic when needed) -->
            <div class="d-flex justify-content-center mt-4">
                <nav>
                    <ul class="pagination pagination-sm">
                        <li class="page-item disabled"><a class="page-link">Previous</a></li>
                        <li class="page-item active"><a class="page-link">1</a></li>
                        <li class="page-item"><a class="page-link">2</a></li>
                        <li class="page-item"><a class="page-link">3</a></li>
                        <li class="page-item"><a class="page-link">Next</a></li>
                    </ul>
                </nav>
            </div>
        </section>
    </div>
</div>

<!-- Quick View Modal -->
<div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-body p-4">
                <div class="row g-3">
                    <div class="col-md-5">
                        <img id="qvImage" src="/images/placeholder.png" class="img-fluid rounded-3 shadow-sm" alt="">
                    </div>
                    <div class="col-md-7">
                        <h4 id="qvName" class="mb-2"></h4>
                        <div class="text-warning mb-2">★★★★★ <small class="text-muted">(4.8)</small></div>
                        <p id="qvDesc" class="text-muted"></p>
                        <div class="fw-bold text-primary fs-4" id="qvPrice"></div>
                        <div class="mt-3">
                            <a id="qvDetails" class="btn btn-outline-primary me-2">View details</a>
                            <a id="qvAdd" class="btn btn-primary">Add to cart</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .object-fit-cover { object-fit: cover; }
    .product-card { transition: transform .25s ease, box-shadow .25s ease; border-radius:12px; }
    .product-card:hover { transform: translateY(-6px); box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
    .product-card img { transition: transform .4s ease; }
    .product-card:hover img { transform: scale(1.03); }
    .product-overlay { display:flex; gap:8px; }
    .text-truncate { display:block; max-height:3.6em; overflow:hidden; }
    .pagination .page-link { color:#444; }
</style>
@Html.Raw("<style>@media (max-width:767px) { .sticky-top { position:static!important; top:auto!important } }</style>")

<script>
    function openQuickView(btn) {
        var id = btn.getAttribute('data-id');
        var name = btn.getAttribute('data-name');
        var price = btn.getAttribute('data-price');
        var desc = btn.getAttribute('data-desc') || '';
        document.getElementById('qvName').innerText = name;
        document.getElementById('qvPrice').innerText = '₹ ' + price;
        document.getElementById('qvImage').src = '/images/' + id + '.png';
        document.getElementById('qvDesc').innerText = desc;
        document.getElementById('qvDetails').href = '/Home/Product_Details?id=' + encodeURIComponent(id);
        document.getElementById('qvAdd').href = '/Home/AddToCart?Product_Id=' + encodeURIComponent(id) + '&productName=' + encodeURIComponent(name) + '&selectedQty=1&selectedTotalPrice=' + encodeURIComponent(price);
        var modal = new bootstrap.Modal(document.getElementById('quickViewModal'));
        modal.show();
    }

    function toggleWishlist(btn, id) {
        var active = btn.classList.toggle('text-danger');
        var hearts = localStorage.getItem('wishlist') ? JSON.parse(localStorage.getItem('wishlist')) : [];
        if (active) {
            hearts.push(id);
        } else {
            hearts = hearts.filter(x => x !== id);
        }
        localStorage.setItem('wishlist', JSON.stringify(hearts));
    }
</script>
