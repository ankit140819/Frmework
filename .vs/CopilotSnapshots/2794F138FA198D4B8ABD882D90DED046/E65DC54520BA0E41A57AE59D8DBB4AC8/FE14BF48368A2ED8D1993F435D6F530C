@model Frmework.Models.Youth
@using Newtonsoft.Json
@{
    var relatedProducts = ViewBag.RelatedProducts as List<Frmework.Models.Youth>;
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" />
<style>
    body{background:#fff;}
    .thumb { width: 70px; cursor: pointer; transition: transform .15s ease; }
    .thumb:hover { transform: scale(1.04); }

    .card { border-radius: 12px; box-shadow: 0 8px 30px rgba(14,22,38,0.06); }

    /* modern gallery */
    .main-image { border-radius:12px; overflow:hidden; background:linear-gradient(180deg,#fff,#fafafa); }
    #thumbContainer { gap:8px; }
    #thumbContainer .thumb { border-radius:8px; border:1px solid #eee; padding:2px; background:white; }

    /* sticky CTA bar */
    .sticky-cta { position: fixed; left: 0; right: 0; bottom: 0; z-index: 1100; background: linear-gradient(90deg,#ffffff, #f8fbff); border-top:1px solid #e9eef8; box-shadow: 0 -8px 24px rgba(20,30,80,0.06); padding:12px 18px; display:none; }
    .sticky-cta .price { font-weight:800; font-size:1.25rem; color:#0b3b6f; }
    @media (max-width: 991px) { .sticky-cta { display:flex; gap:12px; align-items:center; } }

    /* related horizontal carousel */
    .related-row { display:flex; gap:16px; overflow-x:auto; padding-bottom:8px; }
    .related-row .card { min-width:180px; flex:0 0 auto; }

    .feature-badge { background:linear-gradient(90deg,#ff6b9d,#00d4ff); color:white; padding:6px 10px; border-radius:18px; font-weight:600; }

</style>
<div class="container mt-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Products">Products</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Product_Name</li>
        </ol>
    </nav>
    <div class="row">
        <div class="col-md-6">
            <!-- Image gallery / carousel -->
            <div id="productGallery" class="mb-3 card p-3">
                <div class="row g-3 align-items-center">
                    <div class="col-12">
                        <div class="main-image p-3 text-center">
                            <img id="mainImage" src="/images/placeholder.png" class="img-fluid" alt="@Model.Product_Name" style="max-height:420px;" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div id="thumbContainer" class="d-flex align-items-center related-row" role="list">
                            <!-- thumbnails filled by JS -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <h2 class="mb-1">@Model.Product_Name</h2>
            <div class="text-muted mb-2">Deep Hydration • Dewy Finish • 30 ml / 1.01 fl. oz.</div>

            <h4 class="text-dark mb-2" id="amount" data-price="@Model.Product_Amount">₹ @Model.Product_Amount.ToString("N2") INR</h4>
            <div class="mb-2">
                <small class="text-success">Launch offer: 30% off (limited time)</small>
            </div>

            @* Quick highlights *@
            <div class="mb-3 d-flex flex-wrap gap-2">
                <span class="badge bg-light text-dark">Clinically-inspired hydration</span>
                <span class="badge bg-light text-dark">Lightweight, fast-absorbing</span>
                <span class="badge bg-light text-dark">Paraben-free</span>
                <span class="badge bg-light text-dark">Cruelty-free</span>
                <span class="badge bg-light text-dark">Free shipping over ₹500</span>
            </div>

            @* Rating summary (shows only when real comments exist) *@
            <div class="mb-3">
                @{
                    var comments = ViewBag.ProductComments as List<Frmework.Models.ProductComment> ?? new List<Frmework.Models.ProductComment>();
                    var avgRating = ViewBag.AverageRating ?? 0m;
                }
                @if (comments.Count > 0)
                {
                    <div class="d-flex align-items-center">
                        <div class="me-3 text-warning">
                            @for (int i = 0; i < (int)avgRating; i++) { <i class="fa fa-star"></i> }
                            @if (avgRating - (int)avgRating >= 0.5m) { <i class="fa fa-star-half-stroke"></i> }
                            @for (int i = (int)Math.Ceiling(avgRating); i < 5; i++) { <i class="fa fa-star text-muted"></i> }
                        </div>
                        <div class="small text-muted">@avgRating.ToString("0.0") • @comments.Count review(s)</div>
                        <div class="ms-auto small text-muted"><i class="fa fa-truck"></i> Free Shipping</div>
                    </div>
                }
                else
                {
                    <div class="small text-muted">No reviews yet • Be the first to review this product</div>
                }
            </div>

            <div class="d-flex align-items-center gap-2 mb-4">
                <label class="me-2">Qty:</label>
                <button class="btn btn-outline-secondary shadow-none small border border-0 btn-sm" onclick="decreaseQty()"><i class="fa fa-minus"></i></button>
                <input type="text" id="qty" value="1" class="form-control text-center shadow-sm small" style="width:60px;" readonly />
                <button class="btn btn-outline-secondary shadow-none small border border-0 btn-sm" onclick="increaseQty()"><i class="fa fa-plus"></i></button>
            </div>

            <div class="d-flex gap-3 mb-4">
                <a href="javascript:void(0);" onclick="addToCart()" class="btn btn-outline-dark px-4"><i class="fa fa-cart-plus"></i> Add to Cart</a>
                <a href="javascript:void(0);" onclick="buyNow()" class="btn btn-dark px-4">BUY NOW</a>
            </div>

            <h5 class="fw-bold">Product overview</h5>
            <ul class="mb-3">
                <li>Instantly hydrates and plumps the skin for a smoother appearance.</li>
                <li>Helps reduce the look of fine lines with continuous use.</li>
                <li>Creates a dewy, luminous finish without greasiness.</li>
                <li>Compatible under makeup and with most skincare regimens.</li>
            </ul>

            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="p-3 card text-center">
                        <i class="fas fa-leaf fa-2x text-success"></i>
                        <div class="mt-2 small text-muted">Natural Extracts</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 card text-center">
                        <i class="fas fa-flask fa-2x text-info"></i>
                        <div class="mt-2 small text-muted">Clinically Inspired</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 card text-center">
                        <i class="fas fa-sun fa-2x text-warning"></i>
                        <div class="mt-2 small text-muted">Non-greasy Finish</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 card text-center">
                        <i class="fas fa-shield-alt fa-2x text-secondary"></i>
                        <div class="mt-2 small text-muted">Dermatologically Tested</div>
                    </div>
                </div>
            </div>

            <h5>Description</h5>
            <p class="mt-2 text-muted">This lightweight hyaluronic acid serum delivers targeted moisture to the skin’s surface and deeper layers. Formulated to absorb quickly without leaving a tacky after-feel, it helps restore suppleness and visibly reduce the appearance of dehydration lines. Regular use supports a refreshed, glass-like skin texture.</p>

            <p class="text-muted">The concentrated formula combines low- and high-molecular-weight hyaluronic acids for immediate and sustained hydration. Complementary botanical extracts soothe and defend the skin from environmental stressors while supporting a healthy-looking complexion. @Model.Full_Description</p>

            <h6>Who it’s for</h6>
            <p class="text-muted">Suitable for normal, combination and dry skin types. Ideal when skin needs visible plumping and improved texture. If you have ingredient sensitivities, review the full ingredients list below before use.</p>

            <h6>Key ingredients</h6>
            <ul>
                <li><strong>Hyaluronic Acid (multi-weight)</strong> — hydrates and plumps.</li>
                <li><strong>Niacinamide</strong> — brightens and supports the skin barrier.</li>
                <li><strong>Botanical extracts</strong> — soothe and deliver antioxidant benefits.</li>
                <li>Mild preservative system for shelf stability.</li>
            </ul>

            <h6>How to use</h6>
            <ol>
                <li>Cleanse and pat skin dry.</li>
                <li>Apply 2–3 drops to face and neck, morning and night.</li>
                <li>Gently press into skin until absorbed. Follow with moisturizer and SPF in the morning.</li>
            </ol>

            <h6>Performance expectations</h6>
            <p class="text-muted">Visible hydration after first application. Noticeable improvement in skin texture and plumpness within 2–4 weeks for many users. Individual results vary — use consistently for best effect.</p>

            <div class="accordion" id="productAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#info1">More Information</button>
                    </h2>
                    <div id="info1" class="accordion-collapse collapse">
                        <div class="accordion-body">Dermatologically tested. Suitable for most skin types. Refer to packaging for full directions and warnings.</div>
                    </div>
                </div>
            </div>

            <!-- Reviews and Add Comment -->
            <div class="mt-4 card p-3">
                <h5 class="fw-bold">Customer reviews</h5>
                <div class="mb-2 small text-muted">@((ViewBag.ProductComments as List<Frmework.Models.ProductComment>)?.Count ?? 0) reviews</div>

                <div id="reviewsList">
                    @{
                        var comments = ViewBag.ProductComments as List<Frmework.Models.ProductComment> ?? new List<Frmework.Models.ProductComment>();
                        if (comments.Count == 0)
                        {
                            <div class="text-muted">No reviews yet. Be the first to review this product.</div>
                        }
                        else
                        {
                            foreach (var c in comments)
                            {
                                <div class="border-bottom py-2">
                                    <strong>@c.UserName</strong> <small class="text-muted">@c.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small>
                                    <div class="text-warning">
                                        @for (int i=0;i<c.Rating;i++) { <i class="fa fa-star"></i> }
                                        @for (int i=c.Rating;i<5;i++) { <i class="fa fa-star text-muted"></i> }
                                    </div>
                                    <div class="text-muted small">@c.Comment</div>
                                </div>
                            }
                        }
                    }
                </div>

                <div class="mt-3">
                    @if (TempData["CommentResult"] != null)
                    {
                        <div class="alert alert-success">@TempData["CommentResult"]</div>
                    }
                    @* Patch placeholder: no-op *@
                    <form method="post" asp-action="SubmitProductComment" asp-controller="Home">
                        <input type="hidden" name="productId" value="@Model.Product_Id" />
                        <div class="row g-2">
                            <div class="col-md-4">
                                <input name="userName" class="form-control" placeholder="Your name" required />
                            </div>
                            <div class="col-md-3">
                                <select name="rating" class="form-select" required>
                                    <option value="5">5 - Excellent</option>
                                    <option value="4">4 - Very good</option>
                                    <option value="3">3 - Good</option>
                                    <option value="2">2 - Fair</option>
                                    <option value="1">1 - Poor</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <button class="btn btn-primary w-100" type="submit">Submit review</button>
                            </div>
                            <div class="col-12 mt-2">
                                <textarea name="comment" class="form-control" rows="3" placeholder="Share your experience" required></textarea>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="bg-light py-4 mt-3">
    <div class="container my-5">
        <div class="row">
            <div class="col-lg-12">
                <div class="row">
                    @if (relatedProducts != null && relatedProducts.Count > 0)
                    {
                        foreach (var item in relatedProducts)
                        {
                              <div class="col-lg-3 mb-4">
                                <div class="card border border-light border-4 shadow-sm border-0 rounded-4 h-100">
                                    <img src="@Url.Content($"~/images/{item.Product_Id}.png")" class="card-img-top p-3" style="height:180px; object-fit:contain;" onerror="this.src='@Url.Content("~/images/no-image.png")'" />
                                    <div class="card-body text-center">
                                        <h6>@item.Product_Name</h6>
                                        <p class="text-success mb-2">₹ @item.Product_Amount</p>

                                        <a href="@Url.Action("Product_Details", "Home", new { id = item.Product_Id })" class="btn btn-sm btn-dark rounded-3">
                                            View Details
                                        </a>
                                    </div>
                                </div>
                             </div>
                        }
                    }
                    else
                    {
                        <p>No related products found.</p>
                    }
                </div>
            </div>
        </div>
    </div>

</div>
<script>

    document.addEventListener('DOMContentLoaded', function() {
        var qtyEl = document.getElementById('qty');
        if (qtyEl) qtyEl.value = 1;
        loadProductImages();
    });

    function increaseQty() {
        let qty = document.getElementById("qty");
        qty.value = (parseInt(qty.value || '1') + 1).toString();
        updateAmount();
    }

    function decreaseQty() {
        let qty = document.getElementById("qty");
        if (parseInt(qty.value || '1') > 1) {
            qty.value = (parseInt(qty.value || '1') - 1).toString();
            updateAmount();
        }
    }

    function updateAmount() {
        let qty = parseInt(document.getElementById("qty").value || '1');
        let amountEl = document.getElementById("amount");
        let price = parseFloat(amountEl.getAttribute("data-price"));

        let total = qty * price;
        amountEl.innerText = formatter.format(total) + " INR";
    }
        const formatter = new Intl.NumberFormat('en-IN', {
          style: 'currency',
          currency: 'INR',
          minimumFractionDigits: 2,
        });

        function addToCart() {
            let qty = document.getElementById("qty").value;
            let price = parseFloat(document.getElementById("amount").getAttribute("data-price"));
            let total = qty * price;

            let productId = '@Model.Product_Id';
            let productName = '@Model.Product_Name';

            window.location.href = `/Home/AddToCart?Product_Id=${productId}&productName=${productName}&selectedQty=${qty}&selectedTotalPrice=${total}`;
        }

    function buyNow() {
        // reuse addToCart then redirect to Checkout
        let qty = document.getElementById("qty").value;
        let price = parseFloat(document.getElementById("amount").getAttribute("data-price"));
        let total = qty * price;

        let productId = encodeURIComponent('@Model.Product_Id');
        let productName = encodeURIComponent('@Model.Product_Name');

        // Add to cart via same endpoint, then navigate to Checkout
        window.location.href = `/Home/AddToCart?Product_Id=${productId}&productName=${productName}&selectedQty=${qty}&selectedTotalPrice=${total}&returnTo=checkout`;
    }
    function selectImage(src) {
        var main = document.getElementById('mainImage');
        if (main) main.src = src;
    }

    // Probe candidate image URLs and populate thumbnails (client-side so Hot Reload doesn't require app restart)
    (function loadProductImages(){
        var id = '@Model.Product_Id';
        var candidates = [];
        candidates.push('/images/' + id + '.png');
        candidates.push('/images/' + id + '.jpg');
        for (var i=1;i<=8;i++){
            candidates.push('/images/' + id + '_' + i + '.png');
            candidates.push('/images/' + id + '_' + i + '.jpg');
            candidates.push('/images/' + id + '-' + i + '.png');
            candidates.push('/images/' + id + '-' + i + '.jpg');
            candidates.push('/images/' + id + i + '.png');
            candidates.push('/images/' + id + i + '.jpg');
        }

        var found = [];
        var checked = 0;
        var max = candidates.length;

        candidates.forEach(function(url){
            var img = new Image();
            img.onload = function(){
                if (found.indexOf(url) === -1) found.push(url);
                addThumb(url);
                if (document.getElementById('mainImage').src.indexOf('placeholder.png') !== -1) {
                    document.getElementById('mainImage').src = url;
                }
            };
            img.onerror = function(){
                // ignore
            };
            img.src = url;
            checked++;
        });

        function addThumb(url){
            var container = document.getElementById('thumbContainer');
            if (!container) return;
            var wrapper = document.createElement('div');
            wrapper.className = 'thumb';
            wrapper.style.cssText = 'width:72px; height:72px; overflow:hidden; border-radius:8px; cursor:pointer;';
            var im = document.createElement('img');
            im.src = url;
            im.className = 'w-100 h-100 object-fit-cover';
            im.onclick = function(){ selectImage(url); };
            wrapper.appendChild(im);
            container.appendChild(wrapper);
        }
    })();
</script>


