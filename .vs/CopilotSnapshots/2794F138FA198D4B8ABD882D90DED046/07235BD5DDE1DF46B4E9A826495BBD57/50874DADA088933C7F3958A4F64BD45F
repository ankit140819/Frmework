@model List<Frmework.Models.Youth>
@{ 
    ViewData["Title"] = "Products";
    int pageSize = 12;
    int currentPage = 1;
    if (ViewBag.CurrentPage != null && int.TryParse(ViewBag.CurrentPage.ToString(), out int pageNum))
    {
        currentPage = pageNum;
    }
    var totalProducts = Model.Count;
    var totalPages = (int)Math.Ceiling((double)totalProducts / pageSize);
    var startIndex = (currentPage - 1) * pageSize;
    var paginatedProducts = Model.Skip(startIndex).Take(pageSize).ToList();
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

<div class="container my-5">
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h1 class="display-6 fw-bold">Shop the Collection</h1>
            <p class="text-muted mb-0">Hand-picked, science-backed products for your skin. Fast shipping · Secure payment</p>
            @if (Model.Count > 0)
            {
                <small class="text-muted">Showing @(startIndex + 1) - @(Math.Min(startIndex + pageSize, totalProducts)) of @totalProducts products</small>
            }
        </div>
        <div class="col-md-4 text-md-end">
            <form class="d-flex justify-content-end" method="get" asp-action="Products" asp-controller="Home">
                <input name="q" class="form-control form-control-sm me-2" style="max-width:260px" placeholder="Search products..." value="@ViewBag.SearchQuery" />
                <button class="btn btn-primary btn-sm"><i class="fa fa-search"></i></button>
            </form>
        </div>
    </div>

    <div class="row">
        <aside class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm sticky-top p-3" style="top:100px">
                <h6 class="mb-3">
                    <i class="fas fa-sliders-h"></i> Filters
                    @if (!string.IsNullOrEmpty(ViewBag.SearchQuery) || !string.IsNullOrEmpty(ViewBag.SelectedSkinType))
                    {
                        <a href="@Url.Action("Products", "Home")" class="float-end text-danger text-decoration-none" style="font-size: 0.85rem;" title="Clear all filters">
                            Clear filters
                        </a>
                    }
                </h6>
                <form method="get" asp-action="Products" asp-controller="Home">
                    <div class="mb-3">
                        <label class="form-label small"><i class="fas fa-tag"></i> Price range</label>
                        <div class="d-flex gap-2">
                            <input type="number" name="minPrice" class="form-control form-control-sm" placeholder="Min" />
                            <input type="number" name="maxPrice" class="form-control form-control-sm" placeholder="Max" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small"><i class="fas fa-spa"></i> Skin type</label>
                        <select name="skinType" class="form-select form-select-sm">
                            <option value="">All Skin Types</option>
                            <option value="Dry" selected="@(ViewBag.SelectedSkinType == "Dry" ? "selected" : null)">Dry</option>
                            <option value="Oily" selected="@(ViewBag.SelectedSkinType == "Oily" ? "selected" : null)">Oily</option>
                            <option value="Combination" selected="@(ViewBag.SelectedSkinType == "Combination" ? "selected" : null)">Combination</option>
                            <option value="Sensitive" selected="@(ViewBag.SelectedSkinType == "Sensitive" ? "selected" : null)">Sensitive</option>
                            <option value="Normal" selected="@(ViewBag.SelectedSkinType == "Normal" ? "selected" : null)">Normal</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small"><i class="fas fa-sort"></i> Sort</label>
                        <select name="sort" class="form-select form-select-sm">
                            <option value="">Recommended</option>
                            <option value="price_asc">Price: Low to High</option>
                            <option value="price_desc">Price: High to Low</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small"><i class="fas fa-list"></i> Categories</label>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-outline-secondary btn-sm" href="#" onclick="return false;">All</a>
                            <a class="btn btn-outline-secondary btn-sm" href="#" onclick="return false;">Skincare</a>
                            <a class="btn btn-outline-secondary btn-sm" href="#" onclick="return false;">Serums</a>
                            <a class="btn btn-outline-secondary btn-sm" href="#" onclick="return false;">Creams</a>
                        </div>
                    </div>
                    <div class="d-grid">
                        <button class="btn btn-primary btn-sm"><i class="fas fa-check"></i> Apply Filters</button>
                    </div>
                </form>
            </div>
        </aside>

        <section class="col-lg-9">
            @if (paginatedProducts.Any())
            {
                <div class="row g-4">
                    @foreach (var product in paginatedProducts)
                    {
                        var fallback = $"/images/placeholder.png";
                        <div class="col-12 col-sm-6 col-lg-6 col-xl-4">
                            <div class="card product-card h-100 border-0 shadow" style="border-radius:12px; overflow:hidden">
                                <div class="position-relative" style="height:220px; background:linear-gradient(180deg, #fff, #f8f9fa);">
                                    <img data-fallback="@fallback" onerror="handleImageError(this)" src="@Url.Content($"~/images/{product.Product_Id}.png")" class="w-100 h-100 object-fit-cover product-thumb" alt="@product.Product_Name" />
                                    <div class="badge position-absolute top-0 start-0 m-3 bg-white text-dark shadow-sm">New</div>
                                    <button class="btn btn-sm btn-light position-absolute top-0 end-0 m-3" title="Add to wishlist" onclick="toggleWishlist(this, '@product.Product_Id')">
                                        <i class="fa fa-heart"></i>
                                    </button>
                                    <div class="product-overlay position-absolute bottom-0 start-0 w-100 p-3" style="background:linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,0.25))">
                                        <div class="d-flex justify-content-between">
                                            <a asp-action="Product_Details" asp-route-id="@product.Product_Id" class="btn btn-sm btn-outline-light">Details</a>
                                            <button class="btn btn-sm btn-primary" data-id="@product.Product_Id" data-name="@product.Product_Name" data-price="@product.Product_Amount" data-desc="@product.Full_Description" onclick="openQuickView(this)">Quick view</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="mb-1" style="font-size:1rem">@product.Product_Name</h5>
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="me-2 text-warning">★★★★★</div>
                                        <small class="text-muted">(4.8)</small>
                                    </div>
                                    <p class="text-muted small mb-3 text-truncate">@product.Short_Description</p>
                                    @if (!string.IsNullOrEmpty(product.SkinType))
                                    {
                                        <small class="badge bg-info mb-2">@product.SkinType</small>
                                    }
                                    <div class="d-flex align-items-center justify-content-between mt-auto">
                                        <div>
                                            <div class="fw-bold fs-5 text-primary">₹ @product.Product_Amount</div>
                                            <small class="text-muted">Inclusive of taxes</small>
                                        </div>
                                        <div class="btn-group">
                                            <a asp-action="AddToCart" asp-route-Product_Id="@product.Product_Id" asp-route-productName="@product.Product_Name" asp-route-selectedQty="1" asp-route-selectedTotalPrice="@product.Product_Amount" class="btn btn-outline-primary btn-sm">Add</a>
                                            <a asp-action="Product_Details" asp-route-id="@product.Product_Id" class="btn btn-primary btn-sm">Buy</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                <div class="d-flex justify-content-center mt-5">
                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Products", "Home", new { page = 1, q = ViewBag.SearchQuery, skinType = ViewBag.SelectedSkinType })">First</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Products", "Home", new { page = currentPage - 1, q = ViewBag.SearchQuery, skinType = ViewBag.SelectedSkinType })">Previous</a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">First</span>
                                </li>
                                <li class="page-item disabled">
                                    <span class="page-link">Previous</span>
                                </li>
                            }

                            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                            {
                                if (i == currentPage)
                                {
                                    <li class="page-item active">
                                        <span class="page-link">@i <span class="visually-hidden">(current)</span></span>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Products", "Home", new { page = i, q = ViewBag.SearchQuery, skinType = ViewBag.SelectedSkinType })">@i</a>
                                    </li>
                                }
                            }

                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Products", "Home", new { page = currentPage + 1, q = ViewBag.SearchQuery, skinType = ViewBag.SelectedSkinType })">Next</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Products", "Home", new { page = totalPages, q = ViewBag.SearchQuery, skinType = ViewBag.SelectedSkinType })">Last</a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">Next</span>
                                </li>
                                <li class="page-item disabled">
                                    <span class="page-link">Last</span>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i> No products found. Try adjusting your filters.
                </div>
            }
        </section>
    </div>
</div>

<!-- Quick View Modal -->
<div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-body p-4">
                <div class="row g-3">
                    <div class="col-md-5">
                        <img id="qvImage" src="/images/placeholder.png" class="img-fluid rounded-3 shadow-sm" alt="">
                    </div>
                    <div class="col-md-7">
                        <h4 id="qvName" class="mb-2"></h4>
                        <div class="text-warning mb-2">★★★★★ <small class="text-muted">(4.8)</small></div>
                        <p id="qvDesc" class="text-muted"></p>
                        <div class="fw-bold text-primary fs-4" id="qvPrice"></div>
                        <div class="mt-3">
                            <a id="qvDetails" class="btn btn-outline-primary me-2">View details</a>
                            <a id="qvAdd" class="btn btn-primary">Add to cart</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .object-fit-cover { object-fit: cover; }
    .product-card { transition: transform .25s ease, box-shadow .25s ease; border-radius:12px; }
    .product-card:hover { transform: translateY(-6px); box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
    .product-card img { transition: transform .4s ease; }
    .product-card:hover img { transform: scale(1.03); }
    .product-overlay { display:flex; gap:8px; }
    .text-truncate { display:block; max-height:3.6em; overflow:hidden; }
    .pagination .page-link { color:#444; }
</style>
@Html.Raw("<style>@media (max-width:767px) { .sticky-top { position:static!important; top:auto!important } }</style>")

<script>
    function openQuickView(btn) {
        var id = btn.getAttribute('data-id');
        var name = btn.getAttribute('data-name');
        var price = btn.getAttribute('data-price');
        var desc = btn.getAttribute('data-desc') || '';
        document.getElementById('qvName').innerText = name;
        document.getElementById('qvPrice').innerText = '₹ ' + price;
        document.getElementById('qvImage').src = '/images/' + id + '.png';
        document.getElementById('qvDesc').innerText = desc;
        document.getElementById('qvDetails').href = '/Home/Product_Details?id=' + encodeURIComponent(id);
        document.getElementById('qvAdd').href = '/Home/AddToCart?Product_Id=' + encodeURIComponent(id) + '&productName=' + encodeURIComponent(name) + '&selectedQty=1&selectedTotalPrice=' + encodeURIComponent(price);
        var modal = new bootstrap.Modal(document.getElementById('quickViewModal'));
        modal.show();
    }

    function toggleWishlist(btn, id) {
        var active = btn.classList.toggle('text-danger');
        var hearts = localStorage.getItem('wishlist') ? JSON.parse(localStorage.getItem('wishlist')) : [];
        if (active) {
            hearts.push(id);
        } else {
            hearts = hearts.filter(x => x !== id);
        }
        localStorage.setItem('wishlist', JSON.stringify(hearts));
    }

    function handleImageError(img) {
        var fb = img.getAttribute('data-fallback');
        if (fb && fb !== '') {
            img.onerror = null;
            img.src = fb;
            return;
        }
        img.onerror = null;
        img.src = '/images/placeholder.png';
    }
</script>
