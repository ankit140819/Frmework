(() => {
    // Very small client helper for SignalR chat
    const connection = new signalR.HubConnectionBuilder().withUrl('/chathub').build();

    const messagesEl = document.getElementById('liveChatMessages');
    const inputUser = document.getElementById('liveChatUser');
    const inputMessage = document.getElementById('liveChatInput');

    function appendMessage(user, msg, time) {
        if (!messagesEl) return;
        const el = document.createElement('div');
        el.className = 'mb-2';
        el.innerHTML = `<strong>${user}</strong> <small class='text-muted'>${new Date(time).toLocaleTimeString()}</small><div>${escapeHtml(msg)}</div>`;
        messagesEl.appendChild(el);
        messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function escapeHtml(text) {
        return text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    connection.on('ReceiveMessage', (user, message, time) => {
        appendMessage(user, message, time);
    });

    connection.on('LoadHistory', (items) => {
        if (!items || !messagesEl) return;
        items.forEach(i => appendMessage(i.user || i.User, i.message || i.Message, i.time || i.Time));
    });

    connection.start().catch(err => console.error(err.toString()));

    window.sendLiveChat = function() {
        if (!connection || connection.state !== signalR.HubConnectionState.Connected) return;
        const user = inputUser ? inputUser.value : 'Guest';
        const msg = inputMessage ? inputMessage.value.trim() : '';
        if (!msg) return;
        connection.invoke('SendMessage', user, msg).catch(err => console.error(err.toString()));
        if (inputMessage) inputMessage.value = '';
    }
})();
