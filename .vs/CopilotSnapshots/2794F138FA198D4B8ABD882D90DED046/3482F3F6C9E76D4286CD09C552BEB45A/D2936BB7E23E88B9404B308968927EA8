@{
    ViewData["Title"] = "About Us";
}

<section class="about-hero py-5" style="background: linear-gradient(135deg,#f8fafc,#eef2ff);">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold">About GlowSkin</h1>
                <p class="lead text-muted">We create premium, science-backed skincare products designed to bring out your natural glow. Our formulations combine active ingredients with clean, ethical practices.</p>

                <div class="mt-4 d-flex gap-3 flex-wrap">
                    <div class="card border-0 shadow-sm p-3" style="min-width:160px;">
                        <div class="h1 text-primary">🌿</div>
                        <h6 class="fw-bold">Natural Ingredients</h6>
                        <small class="text-muted">Clinically selected botanicals and actives.</small>
                    </div>
                    <div class="card border-0 shadow-sm p-3" style="min-width:160px;">
                        <div class="h1 text-primary">🔬</div>
                        <h6 class="fw-bold">Science First</h6>
                        <small class="text-muted">Formulated with dermatologists and published research.</small>
                    </div>
                    <div class="card border-0 shadow-sm p-3" style="min-width:160px;">
                        <div class="h1 text-primary">♻️</div>
                        <h6 class="fw-bold">Sustainable</h6>
                        <small class="text-muted">Eco-friendly packaging and cruelty-free testing.</small>
                    </div>
                </div>

                <a asp-controller="Home" asp-action="Products" class="btn btn-primary btn-lg mt-4">Shop Now</a>
            </div>
            <div class="col-lg-6 text-center">
                <img src="../images/C00005.png" alt="About GlowSkin" class="img-fluid rounded-4 shadow" style="max-height:360px; object-fit:cover;" />
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-md-6">
                <h3 class="fw-bold">Our Mission</h3>
                <p class="text-muted">To deliver effective skincare solutions that are accessible, responsibly made, and backed by science. We focus on transparency and ingredients you can trust.</p>

                <ul class="list-unstyled">
                    <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Clinically tested actives</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Cruelty-free and vegan options</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Transparent labeling</li>
                </ul>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm p-4">
                    <h5 class="fw-bold">Our Values</h5>
                    <p class="text-muted">Quality, sustainability, and proven results. We partner with ethical suppliers and maintain strict quality control.</p>

                    <div class="d-flex gap-3 mt-3">
                        <div>
                            <h4 class="mb-0">98%</h4>
                            <small class="text-muted">Customer Satisfaction</small>
                        </div>
                        <div>
                            <h4 class="mb-0">500+</h4>
                            <small class="text-muted">Products shipped daily</small>
                        </div>
                        <div>
                            <h4 class="mb-0">150+</h4>
                            <small class="text-muted">Clinically validated formulas</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container">
        <h3 class="fw-bold text-center mb-4">Meet the Team</h3>
        <div class="row g-4 justify-content-center">
            <div class="col-md-3 text-center">
                <img src="https://via.placeholder.com/140.png?text=Dr+Sharma" class="rounded-circle shadow-sm mb-3" style="width:140px; height:140px; object-fit:cover;" alt="Dr. A. Sharma" />
                <h6 class="mb-0 fw-bold">Dr. A. Sharma</h6>
                <small class="text-muted">Chief Formulation Scientist</small>
            </div>
            <div class="col-md-3 text-center">
                <img src="https://via.placeholder.com/140.png?text=Nisha+Patel" class="rounded-circle shadow-sm mb-3" style="width:140px; height:140px; object-fit:cover;" alt="Nisha Patel" />
                <h6 class="mb-0 fw-bold">Nisha Patel</h6>
                <small class="text-muted">Head of Brand</small>
            </div>
            <div class="col-md-3 text-center">
                <img src="https://via.placeholder.com/140.png?text=Ravi+Kumar" class="rounded-circle shadow-sm mb-3" style="width:140px; height:140px; object-fit:cover;" alt="Ravi Kumar" />
                <h6 class="mb-0 fw-bold">Ravi Kumar</h6>
                <small class="text-muted">Head of Customer Success</small>
            </div>
        </div>
    </div>
</section>

<section class="py-5 text-center">
    <div class="container">
        <h3 class="fw-bold mb-3">Join our Newsletter</h3>
        <p class="text-muted">Get exclusive offers and skincare tips. No spam — unsubscribe anytime.</p>
        <form class="d-flex justify-content-center gap-2" method="post" asp-controller="Home" asp-action="SubscribeNewsletter">
            <input name="email" type="email" class="form-control" style="max-width:420px;" placeholder="Enter your email" required />
            <button class="btn btn-primary">Subscribe</button>
        </form>
    </div>
</section>
