@model Frmework.Models.Youth

@{
    var relatedProducts = ViewBag.RelatedProducts as List<Frmework.Models.Youth>;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" />

<style>
    .product-page { padding-top: 40px; padding-bottom: 60px; }
    .product-card { border-radius: 14px; box-shadow: 0 12px 40px rgba(20,20,40,0.06); overflow: hidden; }
    .main-image { height: 420px; background: #fff; display:flex; align-items:center; justify-content:center; }
    .thumb { width:72px; height:72px; overflow:hidden; border-radius:10px; cursor:pointer; border:1px solid #eee; }
    .thumb img { width:100%; height:100%; object-fit:cover; }
    .price-badge { font-size:1.45rem; font-weight:800; color: #0b3b6f; }
    .strike { text-decoration: line-through; color:#999; }
    .badge-feature { background: linear-gradient(90deg,#00d4ff,#667eea); color:white; padding:6px 10px; border-radius:20px; }
    .btn-gradient { background: linear-gradient(90deg,#ff6b9d,#00d4ff); border:none; color:white; }
    .btn-gradient-outline { border:2px solid rgba(102,126,234,0.12); background:transparent; }
    .spec-item { min-height:60px; }
    .related-card img { height:160px; object-fit:contain; }
    @media (max-width: 767px) { .main-image { height:320px; } }
</style>

<div class="container product-page">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="product-card p-3">
                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="main-image rounded-3">
                            <img id="mainImage" src="/images/placeholder.png" alt="@Model.Product_Name" class="img-fluid" style="max-height:100%;" />
                        </div>
                    </div>
                    <div class="col-md-4 d-flex flex-column">
                        <h2 class="mb-2">@Model.Product_Name</h2>
                        <p class="text-muted">@Model.Short_Description</p>

                        <div class="d-flex align-items-center gap-3 my-3">
                            <div class="price-badge">₹ @Model.Product_Amount.ToString("N2")</div>
                            <div class="strike">₹ @(Model.Product_Amount * 1.2).ToString("N2")</div>
                            <span class="badge bg-success">Save 20%</span>
                        </div>

                        <div class="mb-3">
                            <div class="text-warning">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star-half-alt"></i>
                            </div>
                            <small class="text-muted">(4.8 · 128 reviews)</small>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex gap-2 align-items-center">
                                <label class="mb-0">Quantity</label>
                                <div class="input-group" style="width:120px;">
                                    <button class="btn btn-outline-secondary" type="button" onclick="decreaseQty()"><i class="fas fa-minus"></i></button>
                                    <input id="qty" class="form-control text-center" value="1" readonly />
                                    <button class="btn btn-outline-secondary" type="button" onclick="increaseQty()"><i class="fas fa-plus"></i></button>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mb-3">
                            <button class="btn btn-gradient flex-grow-1" onclick="addToCart()"><i class="fas fa-shopping-bag me-2"></i>Add to cart</button>
                            <button class="btn btn-outline-dark flex-grow-1" onclick="buyNow()"><i class="fas fa-credit-card me-2"></i>Buy now</button>
                        </div>

                        <div class="d-flex gap-2 mt-auto">
                            <button class="btn btn-gradient-outline"><i class="fas fa-heart"></i> Wishlist</button>
                            <button class="btn btn-gradient-outline"><i class="fas fa-share-alt"></i> Share</button>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <div class="d-flex gap-2 align-items-center mb-2">
                        <span class="badge-feature">Dermatologist Tested</span>
                        <span class="badge bg-light text-dark">Cruelty Free</span>
                        <span class="badge bg-light text-dark">Paraben Free</span>
                    </div>
                    <hr />
                    <div class="row g-3">
                        <div class="col-md-4 spec-item text-center">
                            <i class="fas fa-leaf fa-2x text-success"></i>
                            <div class="small mt-2 text-muted">Natural Extracts</div>
                        </div>
                        <div class="col-md-4 spec-item text-center">
                            <i class="fas fa-flask fa-2x text-info"></i>
                            <div class="small mt-2 text-muted">Clinically Proven</div>
                        </div>
                        <div class="col-md-4 spec-item text-center">
                            <i class="fas fa-snowflake fa-2x text-primary"></i>
                            <div class="small mt-2 text-muted">Gentle on Skin</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <!-- Tabs for Description / Ingredients / How to Use / Reviews -->
            <div class="card p-3 product-card">
                <ul class="nav nav-tabs" id="productTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab">Description</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="ing-tab" data-bs-toggle="tab" data-bs-target="#ing" type="button" role="tab">Ingredients</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="use-tab" data-bs-toggle="tab" data-bs-target="#use" type="button" role="tab">How to use</button>
                    </li>
                    <li class="nav-item ms-auto" role="presentation">
                        <button class="nav-link" id="rev-tab" data-bs-toggle="tab" data-bs-target="#rev" type="button" role="tab"><i class="fas fa-comment-dots"></i> Reviews</button>
                    </li>
                </ul>
                <div class="tab-content p-3" id="productTabContent">
                    <div class="tab-pane fade show active" id="desc" role="tabpanel">
                        <p class="text-muted">@Model.Full_Description</p>
                        <ul>
                            <li>Lightweight texture absorbs quickly</li>
                            <li>Suitable for daily use</li>
                            <li>Safe for sensitive skin</li>
                        </ul>
                    </div>
                    <div class="tab-pane fade" id="ing" role="tabpanel">
                        <p class="text-muted">Key actives: Niacinamide, Hyaluronic Acid, Botanical Extracts. Full ingredient list on product packaging.</p>
                    </div>
                    <div class="tab-pane fade" id="use" role="tabpanel">
                        <p class="text-muted">Apply a pea-sized amount to clean skin morning and night. Follow with sunscreen during the day.</p>
                    </div>
                    <div class="tab-pane fade" id="rev" role="tabpanel">
                        <div class="small text-muted">128 reviews • Average 4.8</div>
                        <div class="mt-2">
                            <div class="border-bottom py-2">
                                <strong>Priya</strong> <small class="text-muted">(5/5)</small>
                                <div class="text-muted">"My skin feels hydrated and plump after two weeks."</div>
                            </div>
                            <div class="border-bottom py-2">
                                <strong>Rohit</strong> <small class="text-muted">(4/5)</small>
                                <div class="text-muted">"Great texture, lightweight and non-greasy."</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Related products -->
            <div class="mt-4">
                <h5 class="fw-bold">Related products</h5>
                <div class="row g-3">
                    @if (relatedProducts != null && relatedProducts.Count > 0)
                    {
                        foreach (var item in relatedProducts.Take(4))
                        {
                            <div class="col-6">
                                <div class="card related-card p-2 text-center">
                                    <img src="@Url.Content($"~/images/{item.Product_Id}.png")" onerror="this.src='https://via.placeholder.com/200x160.png?text=No+Image'" class="img-fluid" />
                                    <div class="p-2">
                                        <div class="small fw-bold">@item.Product_Name</div>
                                        <div class="small text-success">₹ @item.Product_Amount</div>
                                        <a asp-action="Product_Details" asp-route-id="@item.Product_Id" class="btn btn-sm btn-outline-dark mt-2">View</a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12"><p class="text-muted">No related products found.</p></div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Initialize qty and formatting
    document.addEventListener('DOMContentLoaded', function(){
        const qtyEl = document.getElementById('qty');
        if (qtyEl) qtyEl.value = 1;
        // load images
        loadProductImages();
    });

    function increaseQty() {
        let qty = document.getElementById("qty");
        qty.value = parseInt(qty.value || '1') + 1;
        updateAmount();
    }

    function decreaseQty() {
        let qty = document.getElementById("qty");
        if (parseInt(qty.value) > 1) {
            qty.value = parseInt(qty.value) - 1;
            updateAmount();
        }
    }

    function updateAmount() {
        const qty = parseInt(document.getElementById("qty").value || '1');
        const amountEl = document.querySelector('.price-badge');
        const basePrice = parseFloat('@Model.Product_Amount');
        const total = qty * basePrice;
        if (amountEl) amountEl.innerText = new Intl.NumberFormat('en-IN',{ style: 'currency', currency: 'INR' }).format(total);
    }

    function addToCart() {
        const qty = document.getElementById("qty").value || 1;
        const price = parseFloat('@Model.Product_Amount');
        const total = qty * price;
        const productId = encodeURIComponent('@Model.Product_Id');
        const productName = encodeURIComponent('@Model.Product_Name');
        window.location.href = `/Home/AddToCart?Product_Id=${productId}&productName=${productName}&selectedQty=${qty}&selectedTotalPrice=${total}`;
    }

    function buyNow() {
        const qty = document.getElementById("qty").value || 1;
        const price = parseFloat('@Model.Product_Amount');
        const total = qty * price;
        const productId = encodeURIComponent('@Model.Product_Id');
        const productName = encodeURIComponent('@Model.Product_Name');
        window.location.href = `/Home/AddToCart?Product_Id=${productId}&productName=${productName}&selectedQty=${qty}&selectedTotalPrice=${total}&returnTo=checkout`;
    }

    function selectImage(src) {
        var main = document.getElementById('mainImage');
        if (main) main.src = src;
    }

    // Load product images and thumbnails
    function loadProductImages(){
        var id = '@Model.Product_Id';
        var candidates = [];
        candidates.push('/images/' + id + '.png');
        candidates.push('/images/' + id + '.jpg');
        for (var i=1;i<=6;i++){
            candidates.push('/images/' + id + '_' + i + '.png');
            candidates.push('/images/' + id + '_' + i + '.jpg');
            candidates.push('/images/' + id + '-' + i + '.png');
            candidates.push('/images/' + id + '-' + i + '.jpg');
        }

        var found = [];
        candidates.forEach(function(url){
            var img = new Image();
            img.onload = function(){
                if (found.indexOf(url) === -1) found.push(url);
                addThumb(url);
                var main = document.getElementById('mainImage');
                if (main && main.src.indexOf('placeholder.png') !== -1) main.src = url;
            };
            img.onerror = function(){ };
            img.src = url;
        });

        function addThumb(url){
            var container = document.querySelector('#thumbContainer');
            if (!container) {
                // create thumbnail strip below main image if not present
                var parent = document.querySelector('.main-image').parentElement;
                var div = document.createElement('div');
                div.id = 'thumbContainer';
                div.className = 'd-flex gap-2 mt-3 flex-wrap';
                parent.appendChild(div);
                container = div;
            }
            var wrapper = document.createElement('div');
            wrapper.className = 'thumb';
            var im = document.createElement('img');
            im.src = url;
            im.onclick = function(){ selectImage(url); };
            wrapper.appendChild(im);
            container.appendChild(wrapper);
        }
    }
</script>


