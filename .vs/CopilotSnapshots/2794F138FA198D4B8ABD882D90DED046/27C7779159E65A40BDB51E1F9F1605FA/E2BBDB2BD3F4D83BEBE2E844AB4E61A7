        public IActionResult Product_Details(string id)
        {
            string conStr = _configuration.GetConnectionString("DefaultConnection");

            Youth product = null;

            List<Youth> products = new List<Youth>();

            using (SqlConnection con = new SqlConnection(conStr))
            {
                con.Open();

                using (SqlCommand cmd = new SqlCommand("SP_Products_Master", con))
                {
                    cmd.CommandType = CommandType.StoredProcedure;

                    cmd.Parameters.Add("@flag", SqlDbType.VarChar).Value = "Product_Details";
                    cmd.Parameters.Add("@Product_Id", SqlDbType.VarChar).Value = id;

                    using (SqlDataReader dr = cmd.ExecuteReader())
                    {
                        if (dr.Read())
                        {
                            product = new Youth
                            {
                                Product_Id = dr["Product_Id"].ToString(),
                                Product_Name = dr["Product_Name"].ToString(),
                                Product_Amount = Convert.ToDecimal(dr["Product_Amount"]),
                                Short_Description = dr["Short_Description"].ToString(),
                                    Full_Description = dr["Full_Description"].ToString(),
                                    SkinType = SafeGetString(dr, "SkinType")
                            };
                        }
                    }
                }

                if (product == null)
                {
                    return NotFound();  
                }

                using (SqlCommand cmd = new SqlCommand("SP_Products_Master", con))
                {
                    cmd.CommandType = CommandType.StoredProcedure;

                    cmd.Parameters.Add("@flag", SqlDbType.VarChar).Value = "select";

                    using (SqlDataReader dr = cmd.ExecuteReader())
                    {
                        while (dr.Read())
                        {
                            products.Add(new Youth
                            {
                                Product_Id = dr["Product_Id"].ToString(),
                                Product_Name = dr["Product_Name"].ToString(),
                                Product_Amount = Convert.ToDecimal(dr["Product_Amount"]),
                                Short_Description = dr["Short_Description"].ToString(),
                            Full_Description = dr["Full_Description"].ToString(),
                            SkinType = SafeGetString(dr, "SkinType")
                            });
                        }
                    }
                }
            }

            ViewBag.RelatedProducts = products;

            return View(product);
        }

        
public IActionResult AddToCart(string Product_Id, string productName, int selectedQty, decimal selectedTotalPrice, string returnTo = null)
{
        decimal unitPrice = selectedTotalPrice / selectedQty;

        List<CartItem> cart;

        var sessionCart = HttpContext.Session.GetString("Cart");

        if (sessionCart != null)

            cart = JsonConvert.DeserializeObject<List<CartItem>>(sessionCart);

        else
            cart = new List<CartItem>();

        var existingItem = cart.FirstOrDefault(x => x.ProductId == Product_Id);

        if (existingItem != null)
        {
            existingItem.Quantity = selectedQty;
            existingItem.UnitPrice = unitPrice;
            existingItem.ProductPrice = unitPrice * selectedQty;
        }
        else 
        {
            cart.Add(new CartItem
            {
                ProductId = Product_Id,
                ProductName = productName,
                UnitPrice = unitPrice,
                Quantity = selectedQty,
                ProductPrice = selectedTotalPrice
            });
        }

        HttpContext.Session.SetString("Cart", JsonConvert.SerializeObject(cart));

        // If caller requested immediate checkout, redirect there
        if (!string.IsNullOrEmpty(returnTo) && returnTo.ToLower() == "checkout")
        {
            return RedirectToAction("Checkout", "Checkout");
        }

        return RedirectToAction("Product_Details", new { id = Product_Id });

        }

        public IActionResult RemoveFromCart(string id)
        {
            var sessionCart = HttpContext.Session.GetString("Cart");

            if (sessionCart != null)
            {
                var cart = JsonConvert.DeserializeObject<List<CartItem>>(sessionCart);
                var item = cart.FirstOrDefault(x => x.ProductId == id);

                if (item != null)
                    cart.Remove(item);

                HttpContext.Session.SetString("Cart", JsonConvert.SerializeObject(cart));
            }

            return RedirectToAction("Index"); 
        }

