        private string SafeGetString(SqlDataReader dr, string columnName)
        {
            try
            {
                var ordinal = dr.GetOrdinal(columnName);
                if (!dr.IsDBNull(ordinal))
                    return dr.GetString(ordinal);
            }
            catch
            {
                // Column missing or conversion failed - return null
            }
            return null;
        }

        // New: Products listing with search and advanced filters
        public IActionResult Products(string q, decimal? minPrice, decimal? maxPrice, string sort, string skinType, string concern, string priceRange, string rating, int page = 1)
        {
            string conStr = _configuration.GetConnectionString("DefaultConnection");

            List<Youth> products = new List<Youth>();

            using (SqlConnection con = new SqlConnection(conStr))
            using (SqlCommand cmd = new SqlCommand("SP_Products_Master", con))
            {
                cmd.CommandType = System.Data.CommandType.StoredProcedure;
                cmd.Parameters.AddWithValue("@flag", "select");

                con.Open();
                using (SqlDataReader dr = cmd.ExecuteReader())
                {
                    while (dr.Read())
                    {
                        products.Add(new Youth
                        {
                            Product_Id = dr["Product_Id"].ToString(),
                            Product_Name = dr["Product_Name"].ToString(),
                            Product_Amount = Convert.ToDecimal(dr["Product_Amount"]),
                            Short_Description = dr["Short_Description"].ToString(),
                            Full_Description = dr["Full_Description"].ToString(),
                            SkinType = SafeGetString(dr, "SkinType")
                        });
                    }
                }
            }

            // If database has few products, add generated sample items so the UI shows at least 20 products
            if (products.Count < 20)
            {
                int existing = products.Count;
                for (int i = existing; i < 20; i++)
                {
                    var idx = i + 1;
                    var concerns = new[] { "Anti-Aging", "Acne Control", "Brightening", "Hydrating", "Oil Control" };
                    products.Add(new Youth
                    {
                        Product_Id = $"SAMPLE{idx:D3}",
                        Product_Name = $"Sample Product {idx}",
                        Product_Amount = 199 + (idx * 5),
                        Short_Description = "This is a sample product used for demo and layout purposes.",
                        Full_Description = "Detailed description for sample product used to populate the demo product listing. Replace with real product data from your database.",
                        // Assign example skin types for demo seed data so front-end filtering works without DB field
                        SkinType = (idx % 5) switch
                        {
                            0 => "Dry",
                            1 => "Oily",
                            2 => "Combination",
                            3 => "Sensitive",
                            _ => "Normal"
                        }
                    });
                }
            }

            // Apply search
            if (!string.IsNullOrWhiteSpace(q))
            {
                products = products.Where(p => p.Product_Name?.Contains(q, StringComparison.OrdinalIgnoreCase) == true || p.Short_Description?.Contains(q, StringComparison.OrdinalIgnoreCase) == true).ToList();
                ViewBag.SearchQuery = q;
            }

            // Skin type filter
            if (!string.IsNullOrWhiteSpace(skinType) && skinType != "Any")
            {
                products = products.Where(p => !string.IsNullOrEmpty(p.SkinType) && string.Equals(p.SkinType?.Trim(), skinType.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
                ViewBag.SelectedSkinType = skinType;
            }

            // Concern filter (for future expansion when concern field is added to DB)
            if (!string.IsNullOrWhiteSpace(concern) && concern != "Any")
            {
                ViewBag.SelectedConcern = concern;
            }

            // Apply price filters - support both manual input and preset ranges
            if (!string.IsNullOrWhiteSpace(priceRange))
            {
                ViewBag.SelectedPriceRange = priceRange;
                products = priceRange switch
                {
                    "budget" => products.Where(p => p.Product_Amount >= 100 && p.Product_Amount <= 500).ToList(),
                    "mid" => products.Where(p => p.Product_Amount > 500 && p.Product_Amount <= 1500).ToList(),
                    "premium" => products.Where(p => p.Product_Amount > 1500 && p.Product_Amount <= 3500).ToList(),
                    "luxury" => products.Where(p => p.Product_Amount > 3500).ToList(),
                    _ => products
                };
            }
            else
            {
                if (minPrice.HasValue)
                    products = products.Where(p => p.Product_Amount >= minPrice.Value).ToList();
                if (maxPrice.HasValue)
                    products = products.Where(p => p.Product_Amount <= maxPrice.Value).ToList();
            }

            // Rating filter (simulated for now)
            if (!string.IsNullOrWhiteSpace(rating))
            {
                ViewBag.SelectedRating = rating;
                // In future, add actual rating field to products
            }

            // Sorting
            ViewBag.Sort = sort;
            products = sort switch
            {
                "price_asc" => products.OrderBy(p => p.Product_Amount).ToList(),
                "price_desc" => products.OrderByDescending(p => p.Product_Amount).ToList(),
                "popularity" => products.OrderByDescending(p => p.Product_Id).ToList(),
                "newest" => products.OrderByDescending(p => p.Product_Id).ToList(),
                _ => products
            };

            ViewBag.CurrentPage = page;
            return View(products);
        }

