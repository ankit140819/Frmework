@model List<Frmework.Models.Youth>
@{ViewData["Title"] = "";}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
<div class="bg-white shadow-sm py-5">
   <div class="container">
       <div class="row">
           <div class="col-lg-6">
                <h1 class="display-4 fw-bold my-4 pt-5">Welcome Mr. Ankit Kumar Pandey</h1>
                <p>You can relate with me that is why i can show you the turth this world destroy as soon as possible.</p>
                <button id="txtbutton" class="bg-dark mt-4 mb-5 text-white px-5 py-3 border border-0 fw-bold rounded-2">View More</button>
           </div>
           <div class="col-lg-6">
                <img src="/images/C00001.png" class="d-block w-100" alt="Collagen Booster cream">
           </div>
       </div>
   </div>
</div>
<div class="container my-4">
     <div class="row">
         <div class="col-lg-12 bg-warning rounded-2 pt-4">
            <div id="carouselExampleInterval" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var product = Model[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")" data-bs-interval="@(i == 0 ? 10000 : 2000)">
                            <div class="container">
                                <div class="row align-items-center justify-content-center">
                                    <div class="col-lg-4 ms-4 d-flex align-items-center justify-content-center">
                                        <img src="~/images/@(product.Product_Id).png" class="d-block w-50 rounded-pill" style="height:180px;" alt="@product.Product_Name">
                                    </div>
                                    <div class="col-lg-8 pb-5">
                                        <div class="d-flex align-items-center justify-content-center flex-column">
                                            <h5 class="text-white display-3 fw-bold">@product.Product_Name</h5>
                                            <p class="text-white fs-5">@product.Short_Description</p>
                                            <p class="text-white fs-5"><strong>Amount:</strong> @product.Product_Amount</p>
                                            <a href="@Url.Action("Product_Details", "Home", new { id = product.Product_Id })"
                                               class="btn bg-white text-dark px-5 py-3 rounded-4 mb-2">
                                                Learn More
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Carousel Controls -->
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleInterval" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleInterval" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>

                <!-- Carousel Indicators -->
                <div class="carousel-indicators">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <button type="button" data-bs-target="#carouselExampleInterval" data-bs-slide-to="@i"
                                class="@(i == 0 ? "active" : "") text-dark bg-dark"
                                aria-current="@(i == 0 ? "true" : "false")"
                                aria-label="Slide @(i + 1)">
                        </button>
                    }
                </div>
            </div>
         </div>
        <section class="section_cta">
            <div class="padding-section-medium"></div>
            <div class="padding-global">
                <div class="container-medium">
                    <div class="cta_component">
                        <div class="cta_graphic-wrap">
                            <div data-poster-url="New-Images/Vibrant-(1)-poster-00001.png" data-video-urls="New-Images/Vibrant-(1)-transcode.mp4, New-Images/Vibrant-(1)-transcode.webm" data-autoplay="true" data-loop="true" data-wf-ignore="true" class="cta_graphic w-background-video w-background-video-atom">
                                <video id="video" autoplay="" loop="" style="background-image:url(&quot;New-Images/Vibrant-(1)-poster-00001.jpg&quot;)" muted="" playsinline="" data-wf-ignore="true" data-object-fit="cover">
                                    <source src="New-Images/Vibrant-(1)-transcode.mp4" data-wf-ignore="true">
                                    <source src="New-Images/Vibrant-(1)-transcode.webm" data-wf-ignore="true">
                                </video>
                            </div>
                        </div>
                        <div class="cta_content">
                            <div class="cta_head">
                                <a href="Contact.aspx" class="pill_wrap bg-transparent w-inline-block">
                                    <div class="cta_pill fs-5 text-dark text-decoration-underline fw-bold" style="font-style: italic;">"Your Beauty Soulmate"</div>
                                </a>
                                <div class="spacer-small"></div>
                                <h2 class="heading-style-h5">Our vision is to create high-performance skincare which are meticulously selected and synergized ingredients rooted in modern science meets timeless tradition, using gentle ingredients that deliver visible results and nurture inner and outerskin layers—building lasting trust through non-irritant, highly efficacious, purity, precision and care.</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="padding-section-medium"></div>
        </section>
     </div>
</div>

