@{
    ViewData["Title"] = "Contact Us";
}

<section class="py-5" style="background: linear-gradient(135deg,#eef2ff,#f8f9fa);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold">Get in touch</h1>
                <p class="lead text-muted">Have a question about products, orders, or partnerships? We're here to help.</p>

                <div class="row g-3 mt-4">
                    <div class="col-12 col-sm-6">
                        <div class="d-flex gap-3 align-items-start">
                            <div class="icon-circle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:56px; height:56px;">
                                <i class="fas fa-phone-alt"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Phone</h6>
                                <small class="text-muted">+91 98765 43210</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="d-flex gap-3 align-items-start">
                            <div class="icon-circle bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width:56px; height:56px;">
                                <i class="fas fa-headset"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Support</h6>
                                <small class="text-muted">support@glowskin.example</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <div class="d-flex gap-3 align-items-start">
                            <div class="icon-circle bg-warning text-white rounded-circle d-flex align-items-center justify-content-center" style="width:56px; height:56px;">
                                <i class="fas fa-map-marker-alt"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Address</h6>
                                <small class="text-muted">123 Glow Street, New Delhi, India</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <div class="d-flex gap-3 align-items-start">
                            <div class="icon-circle bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width:56px; height:56px;">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Hours</h6>
                                <small class="text-muted">Mon-Fri 9am - 6pm IST</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <a href="mailto:support@glowskin.example" class="btn btn-primary btn-lg contact-cta"><i class="fas fa-paper-plane me-2"></i>Send an Email</a>
                    <a href="#contact-form" class="btn btn-outline-secondary btn-lg ms-2"><i class="fas fa-comment-alt me-2"></i>Live Chat</a>
                </div>

            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm p-4">
                    <h5 class="fw-bold">Message us</h5>
                    <form id="contact-form" method="post" asp-controller="Home" asp-action="SendContactMessage">
                        <div class="mb-3">
                            <label class="form-label">Full name</label>
                            <input type="text" name="name" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email address</label>
                            <input type="email" name="email" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Message</label>
                            <textarea name="message" class="form-control" rows="5" required></textarea>
                        </div>
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary contact-cta" type="submit"><i class="fas fa-paper-plane me-2"></i>Send Message</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('contact-form').reset();">Reset</button>
                        </div>
                    </form>
                </div>

                <div class="mt-4 text-center small text-muted">
                    We aim to respond within 24 hours on business days.
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .icon-circle { font-size: 1.1rem; }
    .contact-cta { background: linear-gradient(90deg,#667eea,#764ba2); color: white; border-radius: 28px; padding: 10px 22px; }
    .contact-cta:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(102,126,234,0.12); }
</style>
