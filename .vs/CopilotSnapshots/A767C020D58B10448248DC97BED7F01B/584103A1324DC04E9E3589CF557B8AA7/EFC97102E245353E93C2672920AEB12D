@page
@model Frmework.Areas.Admin.Pages.CustomersModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h3>Customers</h3>
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Customer Id</th>
                <th>Name</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
        @foreach(var c in Model.Customers)
        {
            <tr>
                <td>@c.CustomerId</td>
                <td>@c.Name</td>
                <td>@c.Email</td>
            </tr>
        }
        </tbody>
    </table>
</div>
