@page
@model Frmework.Areas.Admin.Pages.AddressesModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h3>Addresses</h3>
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Address Id</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Address</th>
            </tr>
        </thead>
        <tbody>
        @foreach(var a in Model.Addresses)
        {
            <tr>
                <td>@a.Id</td>
                <td>@a.FullName</td>
                <td>@a.Phone</td>
                <td>@a.DisplayAddress</td>
            </tr>
        }
        </tbody>
    </table>
</div>
