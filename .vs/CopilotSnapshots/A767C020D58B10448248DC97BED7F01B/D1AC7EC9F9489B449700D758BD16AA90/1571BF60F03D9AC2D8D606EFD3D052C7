@page "{id?}"
@model Frmework.Areas.Admin.Pages.RetailersManageModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h3>@(Model.IsEdit ? "Edit Retailer" : "Add Retailer")</h3>

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Customer ID</label>
            <input class="form-control" asp-for="Retailer.CustomerId" readonly="@Model.IsEdit" />
        </div>

        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input class="form-control" asp-for="Retailer.FullName" />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" asp-for="Retailer.Email" />
        </div>

        <div class="mb-3">
            <label class="form-label">Phone</label>
            <input class="form-control" asp-for="Retailer.Phone" />
        </div>
            
        <div class="mb-3">
            <label class="form-label">Retailer Type</label>
            <select class="form-select" asp-for="Retailer.Role">
                <option value="Retailer">Retailer</option>
                <option value="Distributor">Distributor</option>
                <option value="Salon">Salon</option>
            </select>
        </div>

        <button class="btn btn-primary">Save</button>
        <a asp-page="./Customers" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>
