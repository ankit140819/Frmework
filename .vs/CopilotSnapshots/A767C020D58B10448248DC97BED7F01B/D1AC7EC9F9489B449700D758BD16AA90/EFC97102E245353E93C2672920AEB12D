@page
@model Frmework.Areas.Admin.Pages.CustomersModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h3>Customers / Retailers</h3>
        <a class="btn btn-primary" asp-page="./RetailersManage">+ Add Retailer</a>
    </div>

    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Customer Id</th>
                <th>Name</th>
                <th>Email</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach(var c in Model.Customers)
        {
            <tr>
                <td>@c.CustomerId</td>
                <td>@c.Name</td>
                <td>@c.Email</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-page="./RetailersManage" asp-route-id="@c.CustomerId">Edit</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
