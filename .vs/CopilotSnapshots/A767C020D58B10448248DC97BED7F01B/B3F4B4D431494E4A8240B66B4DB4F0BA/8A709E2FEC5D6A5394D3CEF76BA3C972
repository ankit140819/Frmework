using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using Microsoft.Data.SqlClient;

namespace Frmework.Areas.Admin.Pages
{
    public class OrdersModel : PageModel
    {
        private readonly IConfiguration _configuration;
        private readonly ILogger<OrdersModel> _logger;

        public List<dynamic> Orders { get; set; } = new List<dynamic>();

        public OrdersModel(IConfiguration configuration, ILogger<OrdersModel> logger)
        {
            _configuration = configuration;
            _logger = logger;
        }

        public IActionResult OnGet()
        {
            var isAdmin = HttpContext.Session.GetString("IsAdmin");
            if (string.IsNullOrEmpty(isAdmin) || isAdmin != "1")
            {
                return RedirectToAction("Login", "Account", new { returnUrl = Url.Page("/Orders", new { area = "Admin" }) });
            }

            try
            {
                string conStr = _configuration.GetConnectionString("DefaultConnection");
                using (SqlConnection con = new SqlConnection(conStr))
                using (SqlCommand cmd = new SqlCommand("SELECT TOP 200 Order_Id, Order_Date, Total_Amount, Status FROM Order_Master ORDER BY Order_Date DESC", con))
                {
                    await con.OpenAsync();
                    using (var reader = await cmd.ExecuteReaderAsync())
                    {
                        while (await reader.ReadAsync())
                        {
                            Orders.Add(new {
                                OrderId = reader["Order_Id"].ToString(),
                                OrderDate = reader["Order_Date"].ToString(),
                                TotalAmount = reader["Total_Amount"].ToString(),
                                Status = reader["Status"]?.ToString() ?? ""
                            });
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error loading orders for admin");
            }

            return Page();
        }
    }
}
