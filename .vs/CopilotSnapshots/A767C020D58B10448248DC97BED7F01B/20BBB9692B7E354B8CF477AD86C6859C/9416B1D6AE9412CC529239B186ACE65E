using Frmework.Models;
using Microsoft.AspNetCore.Mvc;
using Microsoft.Data.SqlClient;
using Newtonsoft.Json;
using System.Data;
using System.Net;
using System.Net.Mail;

namespace Frmework.Controllers
{
    public class CheckoutController : Controller
    {
        private readonly IConfiguration _configuration;
        private readonly ILogger<CheckoutController> _logger;

        public CheckoutController(IConfiguration configuration, ILogger<CheckoutController> logger)
        {
            _configuration = configuration;
            _logger = logger;
        }

        public async Task<IActionResult> Checkout()
        {
            try
            {
                _logger.LogInformation("Checkout initiated at {Time}", DateTime.UtcNow);

                var customerId = HttpContext.Session.GetString("CustId");
                if (string.IsNullOrEmpty(customerId))
                {
                    _logger.LogWarning("Checkout attempted without authentication");
                    return RedirectToAction("Login", "Account", 
                        new { returnUrl = Url.Action("Checkout", "Checkout") });
                }

                var lastOrderId = HttpContext.Session.GetString("LastOrderId");
                if (!string.IsNullOrEmpty(lastOrderId))
                {
                    _logger.LogInformation("Checkout skipped because order already created in session: {LastOrderId}", lastOrderId);
                    TempData["Success"] = $"Order already created. Order ID: {lastOrderId}";
                    return RedirectToAction("Shipping", "Checkout", new { orderId = lastOrderId });
                }

                var orderInProgress = HttpContext.Session.GetString("OrderInProgress");
                if (orderInProgress == "1")
                {
                    _logger.LogWarning("Checkout attempted while another order is in progress for session {SessionId}", HttpContext.Session.Id);
                    TempData["Error"] = "Your order is being processed. Please wait a moment and check your order history.";
                    return RedirectToAction("Products", "Home");
                }

                HttpContext.Session.SetString("OrderInProgress", "1");

                var cart = GetCartFromSession();
                if (cart == null || !cart.Any())
                {
                    _logger.LogWarning("Checkout attempted with empty cart for customer {CustomerId}", customerId);
                    TempData["Error"] = "Your cart is empty. Please add items before checking out.";

                    HttpContext.Session.Remove("OrderInProgress");
                    return RedirectToAction("Products", "Home");
                }

                var (totalQuantity, totalAmount) = CalculateCartTotals(cart);


                string orderId = null;
                const int maxAttempts = 3;
                bool orderMasterInserted = false;

                for (int attempt = 1; attempt <= maxAttempts && !orderMasterInserted; attempt++)
                {
                    orderId = await GetOrderIdAsync();
                    _logger.LogInformation("Attempt {Attempt} - inserting Order {OrderId} for customer {CustomerId}", attempt, orderId, customerId);

                    orderMasterInserted = await InsertOrderMasterAsync(
                        orderId, customerId, HttpContext.Session.Id, totalQuantity, totalAmount);

                    if (!orderMasterInserted)
                    {
                        _logger.LogWarning("InsertOrderMaster failed for order {OrderId} on attempt {Attempt}", orderId, attempt);

                        await Task.Delay(150);
                    }
                }

                if (!orderMasterInserted)
                {
                    _logger.LogError("Failed to insert order master after {MaxAttempts} attempts", maxAttempts);
                    TempData["Error"] = "Failed to create order. Please try again.";
                    HttpContext.Session.Remove("OrderInProgress");
                    return RedirectToAction("Products", "Home");
                }

                foreach (var item in cart)
                {
                    bool detailsInserted = await InsertOrderDetailsAsync(
                        orderId, customerId, item.ProductId?.ToString() ?? "",
                        item.ProductName, item.Quantity, item.ProductPrice,
                        0, item.Quantity * item.ProductPrice, HttpContext.Session.Id);

                    if (!detailsInserted)
                    {
                        _logger.LogError("Failed to insert order detail for item {ProductId} in order {OrderId}",
                            item.ProductId, orderId);
                    }
                }

                HttpContext.Session.Remove("Cart");
                try
                {
                    HttpContext.Session.SetString("LastOrderId", orderId);
                }
                catch { }

                HttpContext.Session.Remove("OrderInProgress");

                _ = SendOrderConfirmationEmailAsync(customerId, orderId, cart, totalAmount);

                _logger.LogInformation("Order {OrderId} successfully created", orderId);
                TempData["Success"] = $"Order created successfully! Order ID: {orderId}";

                return RedirectToAction("Shipping", "Checkout", new { orderId = orderId });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "An error occurred during checkout");
                TempData["Error"] = "An unexpected error occurred. Please try again.";

                try
                {
                    HttpContext.Session.Remove("OrderInProgress");
                }
                catch { }
                return RedirectToAction("Products", "Home");
            }
        }

        public async Task<IActionResult> GetOrderDetails(string orderId)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(orderId))
                {
                    _logger.LogWarning("GetOrderDetails called with empty orderId");
                    return BadRequest("Order ID is required.");
                }

                var orderDetails = await FetchOrderDetailsAsync(orderId);
                if (orderDetails == null)
                {
                    _logger.LogWarning("Order not found: {OrderId}", orderId);
                    return NotFound("Order not found.");
                }

                _logger.LogInformation("Order details retrieved for {OrderId}", orderId);
                return Json(orderDetails);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error fetching order details for {OrderId}", orderId);
                return StatusCode(500, "An error occurred while fetching order details.");
            }
        }
        
        public async Task<IActionResult> OrderHistory(string customerId)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(customerId))
                {
                    _logger.LogWarning("OrderHistory called without customerId");
                    return BadRequest("Customer ID is required.");
                }

                var orders = await FetchCustomerOrdersAsync(customerId);
                _logger.LogInformation("Retrieved {OrderCount} orders for customer {CustomerId}", 
                    orders.Count, customerId);

                return Json(orders);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error retrieving order history for customer {CustomerId}", customerId);
                return StatusCode(500, "An error occurred while retrieving order history.");
            }
        }

        public async Task<string> GetOrderIdAsync()
        {
            try
            {
                string conStr = _configuration.GetConnectionString("DefaultConnection");
                if (string.IsNullOrEmpty(conStr))
                {
                    throw new InvalidOperationException("Connection string not configured.");
                }

                string todayDate = DateTime.Now.ToString("yyyyMMdd");
                string orderId = "";

                using (SqlConnection con = new SqlConnection(conStr))
                {
                    using (SqlCommand cmd = new SqlCommand("SP_YouthCustomaticOrder", con))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.AddWithValue("@Flag", "3");
                        cmd.CommandTimeout = 30;

                        await con.OpenAsync();

                        using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                        {
                            if (await reader.ReadAsync() && reader["MaxOrderId"] != DBNull.Value)
                            {
                                int maxId = Convert.ToInt32(reader["MaxOrderId"]);
                                orderId = todayDate + (maxId + 1).ToString("D6");
                            }
                            else
                            {
                                orderId = todayDate + "000001";
                            }
                        }
                    }
                }

                _logger.LogInformation("Generated Order ID: {OrderId}", orderId);
                return orderId;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error generating order ID");
                return Guid.NewGuid().ToString();
            }
        }

        public async Task<bool> InsertOrderMasterAsync(string orderId, string customerId, 
            string sessionId, int totalQty, decimal totalAmt)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(orderId) || string.IsNullOrWhiteSpace(customerId))
                {
                    _logger.LogWarning("Invalid parameters for InsertOrderMaster");
                    return false;
                }

                string conStr = _configuration.GetConnectionString("DefaultConnection");
                if (string.IsNullOrEmpty(conStr))
                {
                    throw new InvalidOperationException("Connection string not configured.");
                }

                using (SqlConnection con = new SqlConnection(conStr))
                using (SqlCommand cmd = new SqlCommand("SP_YouthCustomaticOrder", con))
                {
                    cmd.CommandType = CommandType.StoredProcedure;
                    cmd.CommandTimeout = 30;

                    cmd.Parameters.AddWithValue("@Flag", "1");
                    cmd.Parameters.AddWithValue("@Order_Id", orderId);
                    cmd.Parameters.AddWithValue("@Order_Date", DateTime.Now);
                    cmd.Parameters.AddWithValue("@Customer_Id", customerId);
                    cmd.Parameters.AddWithValue("@Total_Qty", totalQty);
                    cmd.Parameters.AddWithValue("@Total_Amount", totalAmt);
                    cmd.Parameters.AddWithValue("@User_SessionId", sessionId ?? "");

                    await con.OpenAsync();
                    int result = await cmd.ExecuteNonQueryAsync();

                    _logger.LogInformation("Order master inserted: {OrderId}, Rows affected: {Rows}", 
                        orderId, result);
                    return result > 0;
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error inserting order master for {OrderId}", orderId);
                return false;
            }
        }

        public async Task<bool> InsertOrderDetailsAsync(string orderId, string customerId, 
            string itemCode, string itemName, int quantity, decimal rate, decimal discount, 
            decimal totalAmount, string sessionId)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(orderId) || string.IsNullOrWhiteSpace(customerId) || 
                    string.IsNullOrWhiteSpace(itemCode))
                {
                    _logger.LogWarning("Invalid parameters for InsertOrderDetails");
                    return false;
                }

                string conStr = _configuration.GetConnectionString("DefaultConnection");
                if (string.IsNullOrEmpty(conStr))
                {
                    throw new InvalidOperationException("Connection string not configured.");
                }

                using (SqlConnection con = new SqlConnection(conStr))
                using (SqlCommand cmd = new SqlCommand("SP_YouthCustomaticOrder", con))
                {
                    cmd.CommandType = CommandType.StoredProcedure;
                    cmd.CommandTimeout = 30;

                    cmd.Parameters.AddWithValue("@Flag", "2");
                    cmd.Parameters.AddWithValue("@Order_Id", orderId);
                    cmd.Parameters.AddWithValue("@Customer_Id", customerId);
                    cmd.Parameters.AddWithValue("@Item_code", itemCode);
                    cmd.Parameters.AddWithValue("@Item_Name", itemName ?? "");
                    cmd.Parameters.AddWithValue("@Quantity", quantity);
                    cmd.Parameters.AddWithValue("@Rate", rate);
                    cmd.Parameters.AddWithValue("@Discount", discount);
                    cmd.Parameters.AddWithValue("@ToTal_Amount", totalAmount);
                    cmd.Parameters.AddWithValue("@User_SessionID", sessionId ?? "");

                    await con.OpenAsync();
                    int result = await cmd.ExecuteNonQueryAsync();

                    _logger.LogInformation("Order detail inserted: {OrderId}, Item: {ItemCode}, Rows: {Rows}", 
                        orderId, itemCode, result);
                    return result > 0;
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error inserting order details for {OrderId}", orderId);
                return false;
            }
        }

        public (int totalQuantity, decimal totalAmount) CalculateCartTotals(List<CartItem> cart)
        {
            if (cart == null || !cart.Any())
                return (0, 0);

            int totalQty = cart.Sum(x => x.Quantity);
            decimal totalAmt = cart.Sum(x => x.Quantity * x.ProductPrice);

            _logger.LogInformation("Cart totals calculated: Qty={Qty}, Amount={Amount}", totalQty, totalAmt);
            return (totalQty, totalAmt);
        }

        public string GenerateOrderId()
        {
            string orderId = $"ORD-{DateTime.Now:yyyyMMdd}-{Guid.NewGuid().ToString().Substring(0, 8).ToUpper()}";
            return orderId;
        }

        public List<CartItem> GetCartFromSession()
        {
            try
            {
                var cartJson = HttpContext.Session.GetString("Cart");
                if (string.IsNullOrEmpty(cartJson))
                    return null;

                return JsonConvert.DeserializeObject<List<CartItem>>(cartJson);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error deserializing cart from session");
                return null;
            }
        }

        public async Task<dynamic> FetchOrderDetailsAsync(string orderId)
        {
            try
            {
                string conStr = _configuration.GetConnectionString("DefaultConnection");

                using (SqlConnection con = new SqlConnection(conStr))
                using (SqlCommand cmd = new SqlCommand("SP_YouthCustomaticOrder", con))
                {
                    cmd.CommandType = CommandType.StoredProcedure;
                    cmd.CommandTimeout = 30;
                    cmd.Parameters.AddWithValue("@Flag", "4");
                    cmd.Parameters.AddWithValue("@Order_Id", orderId);

                    await con.OpenAsync();

                    using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                    {
                        if (await reader.ReadAsync())
                        {
                            return new
                            {
                                OrderId = reader["Order_Id"].ToString(),
                                CustomerId = reader["Customer_Id"].ToString(),
                                OrderDate = reader["Order_Date"],
                                TotalQty = reader["Total_Qty"],
                                TotalAmount = reader["Total_Amount"],
                                Status = reader["Status"]?.ToString() ?? "Pending"
                            };
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error fetching order details for {OrderId}", orderId);
            }
            return null;
        }

        public async Task<List<dynamic>> FetchCustomerOrdersAsync(string customerId)
        {
            var orders = new List<dynamic>();
            try
            {
                string conStr = _configuration.GetConnectionString("DefaultConnection");
                using (SqlConnection con = new SqlConnection(conStr))
                using (SqlCommand cmd = new SqlCommand("SP_YouthCustomaticOrder", con))
                {
                    cmd.CommandType = CommandType.StoredProcedure;
                    cmd.CommandTimeout = 30;
                    cmd.Parameters.AddWithValue("@Flag", "5");
                    cmd.Parameters.AddWithValue("@Customer_Id", customerId);

                    await con.OpenAsync();
                    using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                    {
                        while (await reader.ReadAsync())
                        {
                            orders.Add(new
                            {
                                OrderId = reader["Order_Id"].ToString(),
                                OrderDate = reader["Order_Date"],
                                TotalAmount = reader["Total_Amount"],
                                Status = reader["Status"]?.ToString() ?? "Pending"
                            });
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error fetching orders for customer {CustomerId}", customerId);
            }
            return orders;
        }

        public async Task SendOrderConfirmationEmailAsync(string customerId, string orderId, 
            List<CartItem> cart, decimal totalAmount)
        {
            try
            {

                var smtpSettings = _configuration.GetSection("SmtpSettings");
                string smtpServer = smtpSettings["Server"];
                int smtpPort = int.Parse(smtpSettings["Port"] ?? "587");
                string senderEmail = smtpSettings["SenderEmail"];
                string senderPassword = smtpSettings["SenderPassword"];

                if (string.IsNullOrEmpty(smtpServer))
                {
                    _logger.LogWarning("SMTP settings not configured. Email not sent.");
                    return;
                }

                using (SmtpClient client = new SmtpClient(smtpServer, smtpPort))
                {
                    client.EnableSsl = true;
                    client.Credentials = new NetworkCredential(senderEmail, senderPassword);

                    string emailBody = BuildOrderEmailBody(orderId, cart, totalAmount);
                    MailMessage mail = new MailMessage(senderEmail, customerId)
                    {
                        Subject = $"Order Confirmation - {orderId}",
                        Body = emailBody,
                        IsBodyHtml = true
                    };

                    await client.SendMailAsync(mail);
                    _logger.LogInformation("Order confirmation email sent for order {OrderId}", orderId);
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error sending order confirmation email for order {OrderId}", orderId);

            }
        }

        public string BuildOrderEmailBody(string orderId, List<CartItem> cart, decimal totalAmount)
        {
            string itemsHtml = string.Join("", cart.Select(item =>
                $"<tr><td>{item.ProductName}</td><td>{item.Quantity}</td><td>₹{item.ProductPrice}</td><td>₹{item.Quantity * item.ProductPrice}</td></tr>"
            ));

            return $@"
                <h2>Order Confirmation</h2>
                <p>Thank you for your order!</p>
                <p><strong>Order ID:</strong> {orderId}</p>
                <p><strong>Order Date:</strong> {DateTime.Now:dd-MM-yyyy HH:mm:ss}</p>

                <h3>Order Items:</h3>
                <table style='border-collapse: collapse; width: 100%;'>
                    <tr style='background-color: #f0f0f0;'>
                        <th style='border: 1px solid #ddd; padding: 8px;'>Product</th>
                        <th style='border: 1px solid #ddd; padding: 8px;'>Quantity</th>
                        <th style='border: 1px solid #ddd; padding: 8px;'>Price</th>
                        <th style='border: 1px solid #ddd; padding: 8px;'>Total</th>
                    </tr>
                    {itemsHtml}
                </table>

                <h3 style='text-align: right;'>Total Amount: ₹{totalAmount}</h3>
                <p>Your order will be shipped soon. You will receive a tracking number via email.</p>
                <p>Thank you for shopping with us!</p>
            ";
        }
    }
}
