@page
@model Frmework.Areas.Admin.Pages.ProductsModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h3>Products</h3>
        <a class="btn btn-primary" asp-page="./ProductsManage">+ Add Product</a>
    </div>

    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Product Id</th>
                <th>Name</th>
                <th>Price</th>
                <th>Stock</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach(var p in Model.Products)
        {
            <tr>
                <td>@p.ProductId</td>
                <td>@p.ProductName</td>
                <td>₹@p.Price</td>
                <td>@p.Stock</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-page="./ProductsManage" asp-route-id="@p.ProductId">Edit</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
