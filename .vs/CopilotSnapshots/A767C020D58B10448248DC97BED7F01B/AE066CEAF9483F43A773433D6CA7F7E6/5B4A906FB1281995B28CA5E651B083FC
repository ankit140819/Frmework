using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using Microsoft.Data.SqlClient;
using Frmework.Models;

namespace Frmework.Areas.Admin.Pages
{
    public class AddressesModel : PageModel
    {
        private readonly IConfiguration _configuration;
        private readonly ILogger<AddressesModel> _logger;

        public List<Address> Addresses { get; set; } = new List<Address>();

        public AddressesModel(IConfiguration configuration, ILogger<AddressesModel> logger)
        {
            _configuration = configuration;
            _logger = logger;
        }

        public async Task<IActionResult> OnGet()
        {
            var isAdmin = HttpContext.Session.GetString("IsAdmin");
            if (string.IsNullOrEmpty(isAdmin) || isAdmin != "1")
            {
                return RedirectToAction("Login", "Account", new { returnUrl = Url.Page("/Addresses", new { area = "Admin" }) });
            }

            try
            {
                string conStr = _configuration.GetConnectionString("DefaultConnection");
                using (SqlConnection con = new SqlConnection(conStr))
                using (SqlCommand cmd = new SqlCommand("SELECT Address_Id, FullName, Phone, Email, AddressLine1, AddressLine2, City, State, Country, Pincode FROM Address_Master", con))
                {
                    await con.OpenAsync();
                    using (var reader = await cmd.ExecuteReaderAsync())
                    {
                        while (await reader.ReadAsync())
                        {
                            Addresses.Add(new Address {
                                Id = reader["Address_Id"].ToString(),
                                FullName = reader["FullName"].ToString(),
                                Phone = reader["Phone"].ToString(),
                                Email = reader["Email"].ToString(),
                                Line1 = reader["AddressLine1"]?.ToString(),
                                Line2 = reader["AddressLine2"]?.ToString(),
                                City = reader["City"]?.ToString(),
                                State = reader["State"]?.ToString(),
                                Country = reader["Country"]?.ToString(),
                                Pincode = reader["Pincode"]?.ToString()
                            });
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error loading addresses for admin");
            }

            return Page();
        }
    }
}
