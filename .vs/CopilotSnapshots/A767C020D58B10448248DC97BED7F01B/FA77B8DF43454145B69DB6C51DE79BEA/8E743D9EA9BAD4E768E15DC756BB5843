@page
@model Frmework.Areas.Admin.Pages.IndexModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Admin Dashboard</h2>
    <div class="row mt-3">
        <div class="col-md-3">
            <div class="card p-3">
                <div class="h6">Orders</div>
                <div class="display-6">@Model.OrdersCount</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <div class="h6">Products</div>
                <div class="display-6">@Model.ProductsCount</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <div class="h6">Customers</div>
                <div class="display-6">@Model.CustomersCount</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <div class="h6">Addresses</div>
                <div class="display-6">@Model.AddressesCount</div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a class="btn btn-primary me-2" asp-page="./Orders">Manage Orders</a>
        <a class="btn btn-secondary me-2" asp-page="./Products">Manage Products</a>
        <a class="btn btn-secondary me-2" asp-page="./Customers">Manage Customers</a>
        <a class="btn btn-secondary me-2" asp-page="./Addresses">Manage Addresses</a>
        <a class="btn btn-info" asp-page="./Reports">Reports</a>
    </div>

</div>
